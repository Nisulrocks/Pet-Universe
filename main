Fn.runLoop("Playtime", function() return State.autoPlaytime end, function()
	for i = 1, 9 do
		if not State.autoPlaytime then break end
		if Fn.fire("PlaytimeGiftsService", "ClaimGift", "Gift" .. i) then Stats.claims = Stats.claims + 1 end
		task.wait(0.25)
	end
end, function() return 5 end, 0.3)

function Fn.claimPartyEgg()
	local party = Fn.getModule("PartyEgg")
	if party and party.IsReady and not party.IsReady(LocalPlayer) then return end
	if Fn.fire("PartyEggService", "Claim") then Stats.claims = Stats.claims + 1 end
end

Fn.runLoop("PartyEgg", function() return State.autoPartyEgg end, Fn.claimPartyEgg,
	function() return 5 end, 0.3)

-----------------------------------------------------------
-- HATCHING
-----------------------------------------------------------

function Fn.eggModelPosition(eggName)
	local map = Workspace:FindFirstChild("Map")
	local eggs = map and map:FindFirstChild("Eggs")
	local egg = eggs and eggs:FindFirstChild(eggName)
	if not egg then return nil end
	if egg:IsA("Model") then return egg:GetPivot().Position end
	if egg:IsA("BasePart") then return egg.Position end
	return nil
end

-- The client only lets you hatch inside EggRangeModule.RANGE (the server allows a little more).
function Fn.eggRange()
	local mod = Fn.getModule("EggRange")
	return mod and tonumber(mod.RANGE) or 20
end

-- The world an egg lives in, in the zone attribute's naming.
function Fn.eggWorldOf(eggName)
	local mod = Fn.getModule("EggWorld")
	local world = mod and type(mod.EggWorlds) == "table" and mod.EggWorlds[eggName]
	return world and Fn.normWorld(world) or nil
end

-- In the egg's world and close enough to hatch it.
function Fn.atEgg(eggName)
	local world = Fn.eggWorldOf(eggName)
	if world and Fn.currentWorld() ~= world then return false end
	local pos, hrp = Fn.eggModelPosition(eggName), Fn.getHRP()
	return pos ~= nil and hrp ~= nil and (pos - hrp.Position).Magnitude <= Fn.eggRange()
end

-- Gets us to an egg the way a player would: the game's world teleport into its
-- world, then a hop up to it. `abort` cancels it if something outranks us.
function Fn.goToEgg(eggName, abort)
	if Fn.atEgg(eggName) then return true end

	local world = Fn.eggWorldOf(eggName)
	if world and Fn.currentWorld() ~= world and not Fn.travelToWorld(world) then return false end

	local pos = Fn.eggModelPosition(eggName)
	if not pos then return false end
	Fn.teleportTo(Fn.groundAt(pos), 8, 40, abort)
	return Fn.atEgg(eggName)
end

function Fn.goToSelectedEgg()
	Fn.goToEgg(State.egg)
end

-- Egg keeper: while hatching, get back to the egg (right world, within range)
-- whenever we are not at it. Stands down for anything that outranks hatching
-- (alien egg, crafting trip, index) and drops the hop the moment one appears.
Fn.runLoop("AutoTpEgg", function() return State.autoHatch and State.autoTpEgg end, function()
	if Fn.held("hatch") or not Fn.eventGateOpen() or Fn.atEgg(State.egg) then return end
	-- Switching hatching (or the auto-teleport) off cancels the hop, not just future ones.
	Fn.goToEgg(State.egg, function() return Fn.held("hatch") or not (State.autoHatch and State.autoTpEgg) end)
end, function() return 0.5 end, 0.2)

Fn.runLoop("AutoHatch", function() return State.autoHatch end, function()
	if Fn.held("hatch") or not Fn.eventGateOpen() then return end
	if Fn.fire("EggHatchService", "Hatch", State.egg, State.hatchMode) then Stats.hatches = Stats.hatches + 1 end
end, function() return 1.2 end, 0.2)

-- Hatch animation. The server hatches regardless; the animation is the client
-- reacting to EggHatchService.RE.Result. Switching off the game's listeners on
-- that event removes the animation while the eggs keep hatching and the pet
-- inventory (synced separately) keeps updating.
local hatchSilenced = {}

-- The hatch webhook listens to the same event the animation does. When it is
-- attached, the sweep must leave that one listener alone (see ensureHatchListener).
local hatchResultHandler = nil
local hatchListenerVisible = nil -- false when the executor cannot tell listeners apart

function Fn.isOwnHatchListener(conn)
	if hatchResultHandler == nil then return false end
	local ok, fn = pcall(function() return conn.Function end)
	return ok and fn ~= nil and fn == hatchResultHandler
end

function Fn.resultRemote()
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knit = packages and packages:FindFirstChild("Knit")
	local services = knit and knit:FindFirstChild("Services")
	local svc = services and services:FindFirstChild("EggHatchService")
	local re = svc and svc:FindFirstChild("RE")
	return re and re:FindFirstChild("Result")
end

function Fn.suppressHatchAnimation()
	local remote = Fn.resultRemote()
	-- If our own listener cannot be told apart, disabling listeners would silence it too.
	local mayDisable = not (hatchResultHandler ~= nil and hatchListenerVisible == false)
	if mayDisable and remote and typeof(getconnections) == "function" then
		local ok, conns = pcall(getconnections, remote.OnClientEvent)
		if ok and type(conns) == "table" then
			for _, conn in ipairs(conns) do
				if not hatchSilenced[conn] and not Fn.isOwnHatchListener(conn) then
					local disabled = pcall(function() conn:Disable() end)
					if disabled then hatchSilenced[conn] = true end
				end
			end
		end
	end

	-- Sweep any leftover 3D visuals (also the only effect when getconnections is missing).
	local visuals = Workspace:FindFirstChild("EggHatchVisuals")
	if visuals and #visuals:GetChildren() > 0 then
		pcall(function() visuals:ClearAllChildren() end)
	end
end

function Fn.restoreHatchAnimation()
	for conn in pairs(hatchSilenced) do
		pcall(function() conn:Enable() end)
	end
	hatchSilenced = {}
end

-- New listeners can appear after a respawn or reconnect, so keep sweeping.
Fn.runLoop("HatchAnim", function() return State.noHatchAnim end, Fn.suppressHatchAnimation,
	function() return 0.5 end, 0.1)

-----------------------------------------------------------
-- PETS
-----------------------------------------------------------

Fn.runLoop("EquipBest", function() return State.autoEquipBest end, function()
	Fn.fire("PetsService", "Action", "EquipBest")
end, function() return math.clamp(State.equipInterval, 1, 60) end, 0.2) -- slow swaps keep pets attacking

local GOLDEN  = { dataName = "NormalPetsData", need = 8, machine = "GoldenMachine",  machineWorld = "BirchForest", bulk = "CraftBulkGolden",  single = "CraftGolden" }
local DIAMOND = { dataName = "GoldenPetsData", need = 6, machine = "DiamondMachine", machineWorld = "Haunted",     bulk = "CraftBulkDiamond", single = "CraftDiamond" }

-- The server rejects crafts from far away, so a craft is a trip: world teleport
-- to the machine's world, hop to it, craft, go back. `only` limits it to a set of pet names; `force`
-- (the manual buttons) ignores priority. Returns true if a trip was made.
function Fn.craftRun(recipe, only, force, wanted)
	if State.craftBusy then return false end

	local petDisplay = Fn.getModule("PetDisplay")
	local petsData = Fn.dataFolder("PetsData")
	local sub = petsData and petsData:FindFirstChild(recipe.dataName)
	if not (petDisplay and petDisplay.GetAvailable and sub) then return false end

	local function readyList()
		local ready = {}
		for _, pet in ipairs(sub:GetChildren()) do
			if (not only or only[pet.Name]) and petDisplay.GetAvailable(LocalPlayer, pet.Name) >= recipe.need then
				ready[#ready + 1] = pet.Name
			end
		end
		table.sort(ready)
		return ready
	end

	if #readyList() == 0 then return false end
	if Fn.isWorldOwned(recipe.machineWorld) == false then return false end -- machine not unlocked yet
	if not force and Fn.held("craft") then return false end

	local map = Workspace:FindFirstChild("Map")
	local machines = map and map:FindFirstChild("Machines")
	local machine = machines and machines:FindFirstChild(recipe.machine)
	local part = machine and (machine.PrimaryPart or machine:FindFirstChildWhichIsA("BasePart", true))
	local hrp = Fn.getHRP()
	if not hrp or not part then return false end

	-- Hold the claim for the whole trip (even if it errors) so the egg keeper,
	-- index and best-world teleport do not drag us away from the machine.
	State.craftBusy = true
	Fn.setClaim("craft", true)

	local ok, err = pcall(function()
		local home = Fn.savePlace()
		-- The alien egg can interrupt a trip; from then on it owns our position.
		-- Also ends when the feature that asked for it is switched off.
		local function interrupted()
			return (not force and Fn.held("craft") ~= nil) or (wanted ~= nil and not wanted())
		end

		-- 1. The game's world teleport to the machine's world, 2. hop up to it.
		local world = Fn.normWorld(recipe.machineWorld)
		if Fn.currentWorld() ~= world and not Fn.travelToWorld(world, nil, interrupted) then return end -- would not take us; retry later
		if interrupted() then return end

		Fn.teleportTo(Fn.groundAt(part.Position), 12, 40, interrupted)
		if interrupted() then return end

		-- Re-read after arriving; counts can change while we travel.
		local ready = readyList()
		if #ready > 0 then
			local svc = Fn.GetSvc("CraftMachinesService")
			if svc and svc[recipe.bulk] then
				svc[recipe.bulk]:Fire(ready)
			elseif svc and svc[recipe.single] then
				for _, name in ipairs(ready) do svc[recipe.single]:Fire(name) end
			end
			Stats.crafts = Stats.crafts + #ready
			task.wait(1.5)
		end

		-- Back where we started, the same way we came.
		Fn.returnToPlace(home, interrupted)
	end)

	State.craftBusy = false
	Fn.setClaim("craft", false)
	if not ok then error(err, 0) end
	return true
end

function Fn.craftGoldensOnce()  Fn.craftRun(GOLDEN,  nil, true) end
function Fn.craftDiamondsOnce() Fn.craftRun(DIAMOND, nil, true) end

Fn.runLoop("AutoGolden",  function() return State.autoGolden  end, function() Fn.craftRun(GOLDEN,  nil, false, function() return State.autoGolden end) end, function() return 5 end, 0.3)
Fn.runLoop("AutoDiamond", function() return State.autoDiamond end, function() Fn.craftRun(DIAMOND, nil, false, function() return State.autoDiamond end) end, function() return 5 end, 0.3)

-----------------------------------------------------------
-- INDEX FARMING
-----------------------------------------------------------

-- Odds limits: pets rarer than the chosen limit are not chased. Values are the
-- minimum drop chance in percent, the same unit the game's egg pools use.
local INDEX_ODDS = {
	{ "1 in 10", 10 }, { "1 in 20", 5 }, { "1 in 100", 1 }, { "1 in 1,000", 0.1 },
	{ "1 in 10,000", 0.01 }, { "1 in 100,000", 0.001 }, { "1 in 1,000,000", 0.0001 }, { "No limit", 0 },
}
local INDEX_ODDS_NAMES, INDEX_ODDS_PERCENT = {}, {}
for _, entry in ipairs(INDEX_ODDS) do
	INDEX_ODDS_NAMES[#INDEX_ODDS_NAMES + 1] = entry[1]
	INDEX_ODDS_PERCENT[entry[1]] = entry[2]
end

local IndexStatus = "Off"

function Fn.indexHas(name)
	local idx = Fn.dataFolder("IndexData")
	local v = idx and idx:FindFirstChild(name)
	return v ~= nil and v.Value == true
end

-- Unequipped copies of a pet, which is also what the crafting machines can use.
function Fn.petCount(name)
	local petDisplay = Fn.getModule("PetDisplay")
	if petDisplay and petDisplay.GetAvailable then
		local ok, n = pcall(petDisplay.GetAvailable, LocalPlayer, name)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

local ABBREV = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }

-- "14.9k" -> 14900. The leaderboard shows abbreviated strings.
function Fn.parseAbbrev(value)
	if type(value) == "number" then return value end
	local num, suffix = tostring(value):lower():gsub(",", ""):match("^([%d%.]+)%s*(%a*)$")
	num = tonumber(num)
	if not num then return nil end
	if suffix == "" then return num end
	local mult = ABBREV[suffix]
	return mult and num * mult or nil
end

-- Exact figure from the player's stats data when it is a number, otherwise
-- the abbreviated leaderboard value (a little rounded, but fine for affordability).
function Fn.currencyOf(kind)
	local stats = Fn.dataFolder("Stats")
	local v = stats and stats:FindFirstChild(kind)
	if v and typeof(v.Value) == "number" then return v.Value end

	local board = LocalPlayer:FindFirstChild("leaderstats")
	local stat = board and board:FindFirstChild(kind)
	if stat then return Fn.parseAbbrev(stat.Value) end
	return nil
end

function Fn.canAffordEgg(eggName)
	local prices = Fn.getModule("EggPrices")
	local price = prices and tonumber(prices[eggName])
	if not price then return true end
	local have = Fn.currencyOf(eggName:find("Ruby", 1, true) and "Rubies" or "Coins")
	return have == nil or have >= price
end

-- Works out what the Index still needs and the best next action. Golden and
-- Diamond entries are separate Index entries: a golden needs 8 of a normal pet,
-- a diamond needs 6 goldens (so 48 normals).
function Fn.buildIndexPlan()
	local handler = Fn.getModule("EggHandler")
	local eggWorld = Fn.getModule("EggWorld")
	local worldOf = eggWorld and eggWorld.EggWorlds
	if type(handler) ~= "table" or type(worldOf) ~= "table" then return nil, "egg data unavailable" end
	if not Fn.dataFolder("IndexData") then return nil, "index data not loaded yet" end

	local goldenOpen  = Fn.isWorldOwned(GOLDEN.machineWorld)  ~= false
	local diamondOpen = Fn.isWorldOwned(DIAMOND.machineWorld) ~= false

	local plan = { golden = {}, diamond = {}, eggs = {}, pending = 0 }

	for eggName, pool in pairs(handler) do
		local world = worldOf[eggName]
		-- Only real pools of obtainable pets: skip the Universe Egg placeholder and
		-- anything without a physical egg or a known world.
		if type(pool) == "table" and type(pool[1]) == "table" and pool[1].Name
			and eggName ~= "Universe Egg" and world and Fn.eggModelPosition(eggName) then

			for _, pet in ipairs(pool) do
				local name, chance = pet.Name, tonumber(pet.Chance) or 0
				local needNormal  = not Fn.indexHas(name)
				local needGolden  = State.indexVariants and not Fn.indexHas("Golden " .. name)
				local needDiamond = State.indexVariants and not Fn.indexHas("Diamond " .. name)

				local normals = Fn.petCount(name)
				local goldens = Fn.petCount("Golden " .. name)

				-- How many more goldens the Index needs: one for the Golden entry, or the
				-- six a Diamond is made from.
				local goldensWanted = needDiamond and DIAMOND.need or (needGolden and 1 or 0)
				local goldensToMake = math.max(0, goldensWanted - goldens)

				-- Crafts that can happen with what is already owned, whatever the odds.
				if goldensToMake > 0 and goldenOpen and normals >= GOLDEN.need then plan.golden[name] = true end
				if needDiamond and diamondOpen and goldens >= DIAMOND.need then
					plan.diamond["Golden " .. name] = true
				end

				-- Normals still missing, split into "just discover it" and "feed the crafts".
				-- Hatching toward a craft is pointless while its machine's world is locked.
				local variantsPossible = goldenOpen and (not needDiamond or diamondOpen)
				local wantBase = needNormal and chance >= State.indexMinChance
				local wantVariant = variantsPossible and goldensToMake > 0 and chance >= State.indexVariantMin
				local required = math.max(wantBase and 1 or 0, wantVariant and goldensToMake * GOLDEN.need or 0)

				if required > normals then
					plan.pending = plan.pending + 1
					local entry = plan.eggs[eggName]
					if not entry then
						entry = { weight = 0, world = world }
						plan.eggs[eggName] = entry
					end
					entry.weight = entry.weight + chance
				end
			end
		end
	end

	-- Hatch whichever reachable, affordable egg is most likely to drop something we need.
	local bestEgg, bestWeight = nil, 0
	for eggName, entry in pairs(plan.eggs) do
		if Fn.isWorldOwned(entry.world) ~= false and Fn.canAffordEgg(eggName) and entry.weight > bestWeight then
			bestEgg, bestWeight = eggName, entry.weight
		end
	end
	plan.egg = bestEgg
	return plan
end

function Fn.indexStep()
	if not State.autoIndex then
		Fn.setClaim("index", false)
		IndexStatus = "Off"
		return
	end

	local blocker = Fn.held("index")
	if blocker then
		IndexStatus = "Paused - " .. blocker .. " has priority"
		return
	end

	local plan, why = Fn.buildIndexPlan()
	if not plan then
		Fn.setClaim("index", false)
		IndexStatus = why
		return
	end

	-- 1. Crafts that are ready right now are cheap, so they go first.
	if next(plan.golden) then
		Fn.setClaim("index", true)
		IndexStatus = "Crafting golden pets"
		if Fn.craftRun(GOLDEN, plan.golden, false, function() return State.autoIndex end) then return end
	end
	if next(plan.diamond) then
		Fn.setClaim("index", true)
		IndexStatus = "Crafting diamond pets"
		if Fn.craftRun(DIAMOND, plan.diamond, false, function() return State.autoIndex end) then return end
	end

	-- 2. Hatch for what is still missing.
	if not plan.egg then
		Fn.setClaim("index", false)
		IndexStatus = plan.pending > 0
			and string.format("%d pet(s) missing, but no egg is unlocked/affordable", plan.pending)
			or "Index complete for the current limits"
		return
	end

	Fn.setClaim("index", true)
	IndexStatus = string.format("Hatching %s (%d pet(s) still needed)", plan.egg, plan.pending)

	-- Right world and within range of the egg first; a hop that gets cancelled
	-- just means we try again on the next pass.
	if not Fn.goToEgg(plan.egg, function() return Fn.held("index") or not State.autoIndex end) then return end
	if Fn.fire("EggHatchService", "Hatch", plan.egg, State.hatchMode) then Stats.hatches = Stats.hatches + 1 end
end

-- Always running so the claim is released as soon as the toggle goes off.
Fn.runLoop("IndexFarm", function() return true end, Fn.indexStep, function() return 1.2 end, 0.2)

