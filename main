-- Defined in full after the fishing economy, which it reports on; declared here
-- so earlier sections (event alerts) can already post through it.
local Webhook = {}

-----------------------------------------------------------
-- REWARDS
-----------------------------------------------------------

-- Remote formats for several of these are not published anywhere, so each
-- claim goes through tryForms: it sends the likely argument forms in turn and
-- checks the game's own data to see which one the server accepted.

function Fn.dataValue(folderName, key)
	local f = Fn.dataFolder(folderName)
	local v = f and f:FindFirstChild(key)
	return v and v.Value
end

function Fn.clockText(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%dh %02dm", math.floor(seconds / 3600), math.floor((seconds % 3600) / 60))
end

-- Index rewards: Reward1..N flags in IndexRewardsData. Rewards unlock in order,
-- so only the lowest unclaimed one is worth trying on each pass.
local indexRewardTried = {}

function Fn.claimIndexRewards()
	local folder = Fn.dataFolder("IndexRewardsData")
	if not folder then Fn.setFeature("indexRewards", "reward data not loaded") return end

	local numbers = {}
	for _, child in ipairs(folder:GetChildren()) do
		local n = child.Name:match("^Reward(%d+)$")
		if n then numbers[#numbers + 1] = tonumber(n) end
	end
	table.sort(numbers)

	local next_ = nil
	local claimed = 0
	for _, n in ipairs(numbers) do
		if Fn.dataValue("IndexRewardsData", "Reward" .. n) == true then
			claimed = claimed + 1
		elseif not next_ then
			next_ = n
		end
	end

	if not next_ then Fn.setFeature("indexRewards", string.format("all %d claimed", claimed)) return end
	if os.clock() - (indexRewardTried[next_] or -math.huge) < 45 then return end
	indexRewardTried[next_] = os.clock()

	local ok = Fn.tryForms("indexReward", {
		function(n) Fn.fire("IndexService", "ClaimReward", "Reward" .. n) end,
		function(n) Fn.fire("IndexService", "ClaimReward", n) end,
		function(n) Fn.fire("IndexService", "ClaimReward", tostring(n)) end,
	}, function() return Fn.dataValue("IndexRewardsData", "Reward" .. next_) == true end, next_, 1.5)

	if ok then
		Stats.claims = Stats.claims + 1
		Fn.setFeature("indexRewards", string.format("claimed Reward%d", next_))
	else
		Fn.setFeature("indexRewards", string.format("Reward%d not claimable yet (%d/%d done)", next_, claimed, #numbers))
	end
end

-- Daily reward. GetState returns: seconds until the next claim, the streak
-- day, and seconds until the streak resets.
function Fn.dailyState()
	local ok, res = Fn.invoke("DailyRewardsService", "GetState")
	if ok and type(res[1]) == "number" then return res[1], res[2] end
	return nil
end

function Fn.claimDaily()
	local untilClaim, day = Fn.dailyState()
	if not untilClaim then Fn.setFeature("daily", "state unavailable") return end
	if untilClaim > 0 then Fn.setFeature("daily", "next claim in " .. Fn.clockText(untilClaim)) return end

	local ok = Fn.tryForms("daily", {
		function(d) Fn.fire("DailyRewardsService", "ClaimDay", d) end,
		function() Fn.fire("DailyRewardsService", "ClaimDay") end,
		function(d) Fn.fire("DailyRewardsService", "ClaimDay", d + 1) end,
	}, function()
		local w = Fn.dailyState()
		return w ~= nil and w > 0
	end, tonumber(day) or 1, 2.5)

	if ok then
		Stats.claims = Stats.claims + 1
		Fn.setFeature("daily", "claimed day " .. tostring(day))
	else
		Fn.setFeature("daily", "claim was not accepted")
	end
end

-- Group chest: only available to members of the game's group.
function Fn.chestAvailable()
	local ok, res = Fn.invoke("GroupChestService", "IsAvailable")
	return ok and res[1] == true
end

function Fn.claimGroupChest()
	if not Fn.chestAvailable() then Fn.setFeature("groupChest", "not available") return end

	local ok = Fn.tryForms("groupChest", {
		function() Fn.fire("GroupChestService", "ClaimChest") end,
		function()
			Fn.fire("GroupChestService", "RequestChest")
			task.wait(0.5)
			Fn.fire("GroupChestService", "ClaimChest")
		end,
	}, function() return not Fn.chestAvailable() end, nil, 2.5)

	if ok then
		Stats.claims = Stats.claims + 1
		Fn.setFeature("groupChest", "claimed")
	else
		Fn.setFeature("groupChest", "claim was not accepted")
	end
end

-- One-time group rewards (+2 eggs, +1 pet equip, lucky blocks).
function Fn.claimGroupRewards()
	local mod = Fn.getModule("GroupRewards")
	if mod and mod.IsLocalPlayerInGroup then
		local ok, inGroup = pcall(mod.IsLocalPlayerInGroup)
		if ok and inGroup == false then Fn.setFeature("groupRewards", "not in the group") return end
	end
	if Fn.dataValue("GroupRewardsData", "Claimed") == true then Fn.setFeature("groupRewards", "already claimed") return end

	local ok = Fn.tryForms("groupRewards", {
		function() Fn.fire("GroupRewardsService", "ClaimRequest") end,
		function()
			-- The module names a dedicated remote for the claim.
			local okRemote, remote = pcall(mod and mod.GetRemote or function() end)
			if okRemote and typeof(remote) == "Instance" and remote:IsA("RemoteEvent") then remote:FireServer() end
		end,
	}, function() return Fn.dataValue("GroupRewardsData", "Claimed") == true end, nil, 2.5)

	if ok then
		Stats.claims = Stats.claims + 1
		Fn.setFeature("groupRewards", "claimed")
	else
		Fn.setFeature("groupRewards", "claim was not accepted")
	end
end

-- VIP chest: VIP holders only. The cooldown is not published, so this stays slow.
function Fn.openVIPChest()
	if not LocalPlayer:GetAttribute("HasVIP") then Fn.setFeature("vipChest", "no VIP") return end
	if Fn.fire("VIPChestService", "Open") then
		Stats.claims = Stats.claims + 1
		Fn.setFeature("vipChest", "opened")
	end
end

Fn.runLoop("IndexRewards",  function() return State.autoIndexRewards end, Fn.claimIndexRewards, function() return 30 end,  0.2)
Fn.runLoop("DailyReward",   function() return State.autoDaily end,        Fn.claimDaily,        function() return 60 end,  0.2)
Fn.runLoop("GroupChest",    function() return State.autoGroupChest end,   Fn.claimGroupChest,   function() return 120 end, 0.2)
Fn.runLoop("GroupRewards",  function() return State.autoGroupRewards end, Fn.claimGroupRewards, function() return 120 end, 0.2)
Fn.runLoop("VIPChest",      function() return State.autoVIPChest end,     Fn.openVIPChest,      function() return 300 end, 0.1)

function Fn.claimAllRewardsNow()
	Fn.claimIndexRewards()
	Fn.claimDaily()
	Fn.claimGroupChest()
	Fn.claimGroupRewards()
end

-----------------------------------------------------------
-- CODES
-----------------------------------------------------------

-- Codes that the game's own changelog tells players to use.
local CHANGELOG_CODES = { "Release", "Update1", "Update2" }

local CODE_RESULT_NAMES = {}
do
	local mod = Fn.getModule("Codes")
	if mod and type(mod.Result) == "table" then
		for name, value in pairs(mod.Result) do CODE_RESULT_NAMES[value] = name end
	end
end

-- The server answers every redeem on CodesService.RE.Result; show its verdict.
pcall(function()
	local ev = Fn.knitRemote("CodesService", "RE", "Result")
	if not ev then return end
	ev.OnClientEvent:Connect(function(...)
		local args = table.pack(...)
		local parts = {}
		for i = 1, args.n do
			parts[i] = CODE_RESULT_NAMES[args[i]] or tostring(args[i])
		end
		local text = table.concat(parts, " | ")
		Fn.setFeature("codes", "server said: " .. text)
		Fn.notify("Code", text, 5)
	end)
end)

function Fn.redeemCode(raw)
	local code = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if code == "" then return false end

	local mod = Fn.getModule("Codes")
	if mod and mod.Normalize then
		local ok, normalised = pcall(mod.Normalize, code)
		if ok and type(normalised) == "string" and normalised ~= "" then code = normalised end
	end
	return Fn.fire("CodesService", "Redeem", code)
end

-- Accepts one code or several separated by commas / spaces.
function Fn.redeemCodes(text)
	local count = 0
	for code in tostring(text or ""):gmatch("[^,;%s]+") do
		Fn.redeemCode(code)
		count = count + 1
		task.wait(1.5) -- the server rate-limits redeems
	end
	return count
end

-----------------------------------------------------------
-- WORLD TASKS (each one is an errand: world teleport, hop, act, come home)
-----------------------------------------------------------

-- Special upgrades -----------------------------------------------------------

local SPECIAL_COUNT = 17
local specialTried = {}
local specialFolder = nil -- false once we have looked and found none

-- If the game keeps ownership in the data mirror, it is a folder with entries
-- named Upgrade1..; find it once and remember where.
function Fn.findSpecialFolder()
	if specialFolder ~= nil then return specialFolder or nil end
	specialFolder = false
	local mirror = ReplicatedFirst:FindFirstChild("PlayerDataMirror")
	if mirror then
		for _, f in ipairs(mirror:GetChildren()) do
			if f:FindFirstChild("Upgrade1") or f:FindFirstChild("UP1") then
				specialFolder = f
				break
			end
		end
	end
	return specialFolder or nil
end

-- The game draws a billboard (PlayerGui.SPView.UP<n>) over every upgrade.
function Fn.specialBillboard(n)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local view = pg and pg:FindFirstChild("SPView")
	return view and view:FindFirstChild("UP" .. n)
end

-- true / false when known, nil when neither the data nor the billboard says.
function Fn.specialOwned(n)
	local folder = Fn.findSpecialFolder()
	if folder then
		local v = folder:FindFirstChild("Upgrade" .. n) or folder:FindFirstChild("UP" .. n)
		if v then return v.Value == true or (typeof(v.Value) == "number" and v.Value > 0) end
	end

	local bb = Fn.specialBillboard(n)
	local owned = bb and bb:FindFirstChild("UpgradeOwned")
	if owned and owned:IsA("GuiObject") then
		local buy = bb:FindFirstChild("Buy")
		if buy and buy:IsA("GuiObject") then return owned.Visible and not buy.Visible end
		return owned.Visible
	end
	return nil
end

function Fn.specialWorld(n)
	local mod = Fn.getModule("MapWorld")
	local worlds = mod and mod.SpecialUpgradeWorlds
	local w = type(worlds) == "table" and worlds["Upgrade" .. n]
	return w and Fn.normWorld(w) or nil
end

function Fn.specialPrice(n)
	local mod = Fn.getModule("SpecialUpg")
	local entry = mod and mod["Upgrade" .. n]
	return type(entry) == "table" and tonumber(entry.Price) or nil
end

-- Currency from the icon on the billboard's price tag (ids are the game's own
-- coin and ruby icons); nil when it cannot be told.
local CURRENCY_ICONS = { ["117504422618002"] = "Rubies", ["131984855861693"] = "Coins" }

function Fn.specialCurrency(n)
	local bb = Fn.specialBillboard(n)
	local price = bb and bb:FindFirstChild("Price")
	local icon = price and price:FindFirstChild("Icon")
	local image = icon and icon:IsA("ImageLabel") and icon.Image or ""
	for id, currency in pairs(CURRENCY_ICONS) do
		if image:find(id, 1, true) then return currency end
	end
	return nil
end

-- Cheapest upgrade that is not owned, sits in a world we can enter, and (when
-- we can tell) is affordable. Tried upgrades rest for a few minutes.
function Fn.nextSpecialUpgrade()
	local best, bestPrice, unknown = nil, nil, 0
	for n = 1, SPECIAL_COUNT do
		local owned = Fn.specialOwned(n)
		if owned == nil then unknown = unknown + 1 end
		if owned ~= true and os.clock() - (specialTried[n] or -math.huge) > 180 then
			local world, price = Fn.specialWorld(n), Fn.specialPrice(n)
			if world and price and Fn.isWorldOwned(world) ~= false then
				local currency = Fn.specialCurrency(n)
				local have = currency and Fn.currencyOf(currency)
				local affordable = not (have and have < price)
				if affordable and (not bestPrice or price < bestPrice) then best, bestPrice = n, price end
			end
		end
	end
	return best, unknown
end

-- `manual` is true for the button: it runs regardless of the toggle. The
-- automatic loop passes nothing, so switching the toggle off ends the trip.
function Fn.buySpecialUpgrade(manual)
	local n, unknown = Fn.nextSpecialUpgrade()
	if not n then
		Fn.setFeature("special", "nothing to buy right now")
		return
	end

	Fn.errandTrip("SpecialUpgrade", function(interrupted)
		local world = Fn.specialWorld(n)
		if Fn.currentWorld() ~= world and not Fn.travelToWorld(world, nil, interrupted) then return end
		if interrupted() then return end

		local map = Workspace:FindFirstChild("Map")
		local folder = map and map:FindFirstChild("SpecialUpgrades")
		local model = folder and folder:FindFirstChild("Upgrade" .. n)
		if not model then return end

		-- Purchases are range-checked server side (about 40 studs), so get right up to it.
		Fn.teleportTo(Fn.groundAt(model:GetPivot().Position), 8, 40, interrupted)
		if interrupted() then return end

		specialTried[n] = os.clock()
		local ok = Fn.tryForms("specialUpgrade", {
			function(num) Fn.fire("SpecialUpgradesService", "BuySpecialUpgrade", "Upgrade" .. num) end,
			function(num) Fn.fire("SpecialUpgradesService", "BuySpecialUpgrade", num) end,
			function(num) Fn.fire("SpecialUpgradesService", "BuySpecialUpgrade", "UP" .. num) end,
			function(num) Fn.fire("SpecialUpgradesService", "BuySpecialUpgrade", tostring(num)) end,
		}, function() return Fn.specialOwned(n) == true end, n, 2.5, interrupted)

		if ok then
			Stats.upgrades = Stats.upgrades + 1
			Fn.setFeature("special", string.format("bought Upgrade%d", n))
		else
			Fn.setFeature("special", string.format("Upgrade%d not bought%s", n,
				unknown > 0 and " (ownership unreadable - cannot confirm)" or ""))
		end
	end, function() return manual == true or State.autoSpecial end)
end

Fn.runLoop("SpecialUpgrades", function() return State.autoSpecial end, Fn.buySpecialUpgrade, function() return 15 end, 0.2)

-- Fruit machine --------------------------------------------------------------

function Fn.fruitTotal()
	local f = Fn.dataFolder("FruitsData")
	local sum = 0
	if f then
		for _, c in ipairs(f:GetChildren()) do
			if typeof(c.Value) == "number" then sum = sum + c.Value end
		end
	end
	return sum
end

function Fn.fruitCooldown()
	local ok, res = Fn.invoke("FruitMachineService", "GetCooldownRemaining")
	if ok and type(res[1]) == "number" then return res[1] end
	return nil
end

function Fn.rollFruitMachine(manual)
	local cooldown = Fn.fruitCooldown()
	if cooldown == nil then Fn.setFeature("fruit", "cooldown unavailable") return end
	if cooldown > 0 then Fn.setFeature("fruit", "ready in " .. Fn.clockText(cooldown)) return end

	local cfg = Fn.getModule("FruitCfg") or {}
	local count = math.clamp(State.fruitsPerRoll, tonumber(cfg.MIN_FRUITS) or 1, tonumber(cfg.MAX_FRUITS) or 5)
	local cost = (tonumber(cfg.PRICE_PER_FRUIT) or 500) * count

	local coins = Fn.currencyOf("Coins")
	if coins and coins < cost then Fn.setFeature("fruit", "need " .. cost .. " coins") return end

	local mapWorlds = Fn.getModule("MapWorld")
	local world = Fn.normWorld(mapWorlds and mapWorlds.MachineWorlds and mapWorlds.MachineWorlds.FruitMachine or "FrozenAlley")
	if Fn.isWorldOwned(world) == false then Fn.setFeature("fruit", "machine's world is locked") return end

	Fn.errandTrip("FruitMachine", function(interrupted)
		if Fn.currentWorld() ~= world and not Fn.travelToWorld(world, nil, interrupted) then return end
		if interrupted() then return end

		local map = Workspace:FindFirstChild("Map")
		local machines = map and map:FindFirstChild("Machines")
		local machine = machines and machines:FindFirstChild("FruitMachine")
		local part = machine and (machine.PrimaryPart or machine:FindFirstChildWhichIsA("BasePart", true))
		if not part then return end

		Fn.teleportTo(Fn.groundAt(part.Position), 12, 40, interrupted)
		if interrupted() then return end

		-- A roll is confirmed by the fruit count going up.
		local before = Fn.fruitTotal()
		local ok = Fn.tryForms("fruitRoll", {
			function(c) Fn.invoke("FruitMachineService", "Roll", c) end,
			function() Fn.invoke("FruitMachineService", "Roll") end,
		}, function() return Fn.fruitTotal() > before end, count, 3, interrupted)

		if ok then
			Stats.claims = Stats.claims + 1
			Fn.setFeature("fruit", string.format("rolled (+%d fruit)", Fn.fruitTotal() - before))
		else
			Fn.setFeature("fruit", "roll was not accepted")
		end
	end, function() return manual == true or State.autoFruitMachine end)
end

Fn.runLoop("FruitMachine", function() return State.autoFruitMachine end, Fn.rollFruitMachine, function() return 20 end, 0.2)

-- Ben hunt -------------------------------------------------------------------

local benTried = {}

-- Bens still to find, in worlds we can enter, grouped by world so a trip does
-- not bounce between worlds.
function Fn.pendingBens()
	local cfg = Fn.getModule("BenCfg")
	local data = Fn.dataFolder("BenFindData")
	local list = {}
	if not (cfg and type(cfg.BENS) == "table" and data) then return list end

	for _, ben in ipairs(cfg.BENS) do
		local v = data:FindFirstChild(ben.Id)
		local collected = v ~= nil and v.Value == true
		if not collected and Fn.isWorldOwned(Fn.normWorld(ben.World)) == true
			and os.clock() - (benTried[ben.Id] or -math.huge) > 300 then
			list[#list + 1] = ben
		end
	end
	table.sort(list, function(a, b)
		if a.World ~= b.World then return a.World < b.World end
		return a.Id < b.Id
	end)
	return list
end

-- The game spawns each Ben's model locally once you are in its world.
function Fn.findBenModel(id, timeout)
	local deadline = os.clock() + timeout
	repeat
		local folder = Workspace:FindFirstChild("BenFindLocal")
		if folder then
			for _, m in ipairs(folder:GetChildren()) do
				if m:GetAttribute("BenId") == id then return m end
			end
		end
		task.wait(0.5)
	until os.clock() >= deadline
	return nil
end

function Fn.benCollected(id)
	return Fn.dataValue("BenFindData", id) == true
end

-- One Ben: world teleport, hop up, click it, and confirm from the collected flag.
function Fn.collectBen(ben, interrupted)
	benTried[ben.Id] = os.clock()

	local world = Fn.normWorld(ben.World)
	if Fn.currentWorld() ~= world and not Fn.travelToWorld(world, nil, interrupted) then return false end

	local model = Fn.findBenModel(ben.Id, 6)
	local pos = model and model:GetPivot().Position
	local cfg = Fn.getModule("BenCfg")
	if not pos and cfg and cfg.PositionOf then
		local ok, p = pcall(cfg.PositionOf, ben.Id)
		if ok and typeof(p) == "Vector3" then
			pos = p
		elseif ok and typeof(p) == "CFrame" then
			pos = p.Position
		end
	end
	if not pos then return false end

	-- Claims are range-checked (MAX_CLAIM_DISTANCE), so get properly close.
	Fn.teleportTo(Fn.groundAt(pos), 12, 40, interrupted)
	if interrupted() then return false end

	local det = model and model:FindFirstChildWhichIsA("ClickDetector", true)
	if det and typeof(fireclickdetector) == "function" then
		fireclickdetector(det)
		task.wait(1)
	end

	-- If the click alone did not register it, send the claim ourselves.
	if not Fn.benCollected(ben.Id) then
		local remote = ReplicatedStorage:FindFirstChild("Remotes")
		remote = remote and remote:FindFirstChild("BenFind")
		remote = remote and remote:FindFirstChild("ClaimBen")
		if remote and remote:IsA("RemoteEvent") then
			remote:FireServer(ben.Id)
		elseif remote and remote:IsA("RemoteFunction") then
			pcall(function() remote:InvokeServer(ben.Id) end)
		end
		task.wait(1)
	end

	return Fn.benCollected(ben.Id)
end

function Fn.huntBens(manual)
	local bens = Fn.pendingBens()
	if #bens == 0 then Fn.setFeature("ben", "none left to find") return end

	local found = 0
	Fn.errandTrip("BenHunt", function(interrupted)
		for _, ben in ipairs(bens) do
			if interrupted() then return end
			if Fn.collectBen(ben, interrupted) then
				found = found + 1
				Stats.claims = Stats.claims + 1
			end
		end
	end, function() return manual == true or State.autoBenHunt end)

	Fn.setFeature("ben", string.format("found %d of %d this trip", found, #bens))
end

Fn.runLoop("BenHunt", function() return State.autoBenHunt end, Fn.huntBens, function() return 30 end, 0.2)

-----------------------------------------------------------
-- EVENT ALERTS
-----------------------------------------------------------

local alertedEvents = {}
local alienEvent = nil -- the alien egg currently being tracked: { world, before, clicks0, announced, goneAt }

-- Player-facing world name, from the game's own display names.
function Fn.worldLabel(world)
	if not world then return "an unknown world" end
	local cfg = Fn.getModule("WorldCost")
	local names = cfg and cfg.DisplayNames
	return (type(names) == "table" and names[world]) or world
end

-- Alien eggs are kept with the player's other eggs.
function Fn.alienEggCount()
	local v = Fn.dataValue("Eggs", "Alien Egg")
	return type(v) == "number" and v or nil
end

Fn.runLoop("EventAlerts", function() return State.eventAlerts end, function()
	local function alert(title, body, color)
		Fn.notify(title, body, 6)
		Webhook.post({ title = title, description = body, color = color or 0x6464FF })
	end

	for name in pairs(ActiveEvents) do
		if not alertedEvents[name] then
			alertedEvents[name] = true
			alert("Event started", name .. " is active", 0x6464FF)
		end
	end
	for name in pairs(alertedEvents) do
		if not ActiveEvents[name] then alertedEvents[name] = nil end
	end

	local eggUp = alienRef ~= nil and alienRef.Parent ~= nil

	if eggUp then
		if not alienEvent then
			alienEvent = { before = Fn.alienEggCount(), clicks0 = alienClicks, seenAt = os.clock() }
		end
		local ev = alienEvent
		ev.goneAt = nil
		ev.world = ev.world or Fn.alienWorld(alienRef)

		-- Wait a moment for the world to be known so the alert can name it.
		if not ev.announced and (ev.world or os.clock() - ev.seenAt >= 6) then
			ev.announced = true
			alert("Alien egg spawned", "Spawned in " .. Fn.worldLabel(ev.world), 0x00FF78)
		end

	elseif alienEvent then
		-- Gone. Give the inventory a few seconds to update before judging, and
		-- ignore a brief flicker in the scan.
		local ev = alienEvent
		ev.goneAt = ev.goneAt or os.clock()
		if os.clock() - ev.goneAt >= 6 then
			alienEvent = nil

			local after = Fn.alienEggCount()
			local gained = (after and ev.before) and (after - ev.before) or nil
			local where = Fn.worldLabel(ev.world)
			local hits = alienClicks - ev.clicks0

			if gained and gained > 0 then
				alert("Alien egg destroyed - you got it!",
					string.format("+%d Alien Egg from %s (you now have %d)", gained, where, after), 0x00FF78)
			elseif gained == nil then
				alert("Alien egg gone", "Could not tell if you got it (" .. where .. ")", 0x6464FF)
			else
				alert("Alien egg gone - you missed it",
					string.format("It was in %s and nothing was added to your eggs%s", where,
						hits > 0 and string.format(" (you hit it %d times)", hits) or ""), 0xFF1E1E)
			end
		end
	end
end, function() return 2 end, 0.1)

-----------------------------------------------------------
-- FISHING
-----------------------------------------------------------

-- How the game's fishing minigame works (read from its own modules):
--   * FishingService.StartFishing() opens a session near water and returns a
--     TapSeed. Water is any part tagged "FishingWater"; the cast reaches 16
--     studs, and walking more than 8 studs from where it started ends it.
--   * Each cast takes 10s. SpeedUp(tapIndex, x, y) shortens it by tapping a
--     target; x/y are 0-1 screen positions. The server regenerates the target
--     for that index from the TapSeed (FishingTaps.NewSequence) and accepts a
--     tap that lands within HIT_X / HIT_Y of it.
--   * The server recasts by itself after a catch, so fishing is just: start,
--     keep tapping, stay put. Eggs cannot be hatched while fishing.

local CollectionService = game:GetService("CollectionService")

local useFishBoostsHook = nil -- assigned in the fishing economy section

local Fish = {
	active     = false,
	index      = 1,        -- next tap index, as the server reports it
	seed       = nil,
	tapAt      = nil,      -- function(index) -> x, y built from the game's tap sequence
	method     = "sequence",
	lastTap    = nil,
	rejects    = 0,        -- consecutive rejected or unanswered taps
	sent       = 0,
	accepted   = 0,
	streak     = 0,
	caught     = 0,
	lastCatch  = "nothing yet",
	lastStop   = "",
	failStreak = 0,
	pauseUntil = 0,
	nextTapAt  = 0,
	lastReply  = "",
	seqInfo    = "n/a",
	good       = nil,      -- { world, position } where a session last started
	endsAt     = nil,      -- server time the current cast finishes
	startedAt  = 0,
	replyIndex = nil,      -- the tap index in the server's last answer
	replyAt    = nil,      -- when that answer arrived
	lastSendAt = -math.huge,
	plan       = 1,        -- which way of sending a tap is being used (see TAP_PLANS)
	planRejects = 0,
	cycled     = 0,        -- full passes through every plan without a single accepted tap
	won        = false,    -- the current plan has been accepted by the server
	restUntil  = 0,        -- taps are paused until then (the cast still finishes by itself)
	lastSent   = "",
	catches    = nil,
}

-- Ways of sending one tap, tried in this order until the server accepts one. The
-- target always comes from the game's own tap sequence. The game's client sends
-- SpeedUp(index, x, y, clicks); the server accepts a single click per call, and it
-- moves the target on by itself (about 0.8 indexes per second), so the index has to
-- be read fresh every time. Counted clicks and a full count of 10 are rejected.
--   idx    "fresh" (asked of the server now), "fresh1" (one ahead) or "reply" (from its last answer)
--   clicks the count sent as the fourth value, or false for the old three-argument call
local TAP_PLANS = {
	{ idx = "fresh",  clicks = 1 },
	{ idx = "fresh1", clicks = 1 },
	{ idx = "reply",  clicks = 1 },
	{ idx = "fresh",  clicks = false },
}

local TAP_INDEX_RATE = 0.805 -- target indexes the server advances per second (measured from its answers)

-- Tap sources ---------------------------------------------------------------

function Fn.inUnitRange(x, y)
	return type(x) == "number" and type(y) == "number" and x >= 0 and x <= 1 and y >= 0 and y <= 1
end

-- Accepts (x, y), a Vector2, or a table holding x/y; returns nil otherwise.
function Fn.toXY(a, b)
	if type(a) == "number" and type(b) == "number" then return a, b end
	if typeof(a) == "Vector2" then return a.X, a.Y end
	if type(a) == "table" then
		local x = a.x or a.X or a[1]
		local y = a.y or a.Y or a[2]
		if type(x) == "number" and type(y) == "number" then return x, y end
	end
	return nil
end

-- FishingTaps.NewSequence(seed) is what the server uses to place each target,
-- so asking it gives the exact position for every index. The shape it returns
-- is not documented (a function, an object with a next-style method, or a
-- list), so every shape is handled; the server's own Accepted flag decides
-- whether the guess was right.
function Fn.newTapSource(seed)
	local mod = Fn.getModule("FishTaps")
	if not (mod and type(mod.NewSequence) == "function") then return nil end

	local ok, seq = pcall(mod.NewSequence, seed)
	if not ok or seq == nil then
		Fish.seqInfo = "NewSequence failed: " .. tostring(seq)
		return nil
	end
	Fish.seqInfo = typeof(seq)

	local steps, produced = {}, 0

	local function advance(index)
		if type(seq) == "function" then
			local r = table.pack(pcall(seq, index))
			if r[1] then return Fn.toXY(r[2], r[3]) end
			return nil
		end

		if type(seq) == "table" then
			for _, name in ipairs({ "Next", "next", "Step", "Get", "At", "Pop" }) do
				local fn = seq[name]
				if type(fn) == "function" then
					local x, y
					local r = table.pack(pcall(fn, seq, index)) -- as a method
					if r[1] then x, y = Fn.toXY(r[2], r[3]) end
					if x then return x, y end

					r = table.pack(pcall(fn, index)) -- as a plain function
					if r[1] then x, y = Fn.toXY(r[2], r[3]) end
					if x then return x, y end
				end
			end
			if seq[index] ~= nil then return Fn.toXY(seq[index]) end
		end
		return nil
	end

	-- Stateful sequences only move forward, so produce every step up to the one asked for.
	return function(index)
		while produced < index do
			produced = produced + 1
			local x, y = advance(produced)
			if not Fn.inUnitRange(x, y) then return nil end
			steps[produced] = { x, y }
		end
		local s = steps[index]
		if not s then return nil end
		return s[1], s[2]
	end
end

-- Where the target for `index` is, from the game's tap sequence; nil when it cannot be told.
function Fn.tapTarget(index)
	local x, y
	if Fish.tapAt then x, y = Fish.tapAt(index) end
	if not x then return nil end
	-- A hair of noise, well inside the hit box, so taps are not pixel-identical.
	return x + (math.random() - 0.5) * 0.008, y + (math.random() - 0.5) * 0.008
end

function Fn.planText(plan)
	return string.format("index %s | clicks %s", plan.idx, plan.clicks and tostring(plan.clicks) or "none")
end

-- Moves on to the next way of sending a tap. Two full passes with nothing accepted
-- means the server is not taking taps right now: pause them and let the cast run out
-- by itself (fishing carries on without taps, just slower), then probe again later.
function Fn.nextPlan()
	Fish.plan = Fish.plan % #TAP_PLANS + 1
	Fish.planRejects = 0
	Fish.won = false
	if Fish.plan == 1 then
		Fish.cycled = Fish.cycled + 1
		if Fish.cycled >= 2 then
			Fish.cycled = 0
			Fish.restUntil = os.clock() + 120
		end
	end
end

-- Session ---------------------------------------------------------------------

function Fn.describe(data)
	if type(data) == "string" then return data end
	if type(data) ~= "table" then return "no answer from the server" end
	local parts = {}
	for k, v in pairs(data) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end
	table.sort(parts)
	return table.concat(parts, ", ")
end

-- Takes over the numbers of a session the server describes (from StartFishing or GetSession).
function Fn.adoptSession(data)
	Fish.active = true
	if tonumber(data.TapIndex) then
		Fish.index = tonumber(data.TapIndex)
		Fish.replyAt = os.clock()
	end
	if data.TapSeed ~= nil and data.TapSeed ~= Fish.seed then
		Fish.seed = data.TapSeed
		Fish.tapAt = Fn.newTapSource(Fish.seed)
	end
	Fish.streak = tonumber(data.Streak) or Fish.streak
	Fish.endsAt = tonumber(data.EndsAt) or Fish.endsAt
	Fish.catches = tonumber(data.Catches) or Fish.catches
end

-- The server's view of the running session, or nil.
function Fn.getSession()
	local ok, res = Fn.invoke("FishingService", "GetSession")
	local data = ok and res[1]
	if type(data) == "table" and (data.TapIndex ~= nil or data.EndsAt ~= nil) then return data end
	return nil
end

-- The tap index the server is on right now. It moves with time, so ask; if the
-- answer is unusable, carry the last known one forward at the measured rate.
function Fn.currentIndex()
	local session = Fn.getSession()
	if session then
		Fn.adoptSession(session)
		if tonumber(session.TapIndex) then return tonumber(session.TapIndex) end
	end
	if Fish.replyAt then return Fish.index + math.floor((os.clock() - Fish.replyAt) * TAP_INDEX_RATE) end
	return Fish.index
end

function Fn.startFishing()
	-- ReplicatedStorage.Packages.Knit.Services.FishingService.RF.StartFishing:InvokeServer()
	local ok, res = Fn.invoke("FishingService", "StartFishing")
	local data = res[1]
	if not ok or type(data) ~= "table" or data.Ok ~= true then
		-- Already fishing (the game resumes sessions by itself): join it instead of failing.
		if LocalPlayer:GetAttribute("FishingActive") then
			local session = Fn.getSession()
			if session then
				Fn.adoptSession(session)
				Fish.lastStop = ""
				return true
			end
		end
		Fish.lastStop = "could not start: " .. Fn.describe(data)
		return false
	end

	Fn.adoptSession(data)
	Fn.sessionStarted()
	return true
end

-- Resets what is tracked per session; used however the session came about.
function Fn.sessionStarted()
	Fish.rejects = 0
	Fish.planRejects = 0
	Fish.lastTap = nil
	Fish.lastStop = ""
	Fish.lastReply = ""
	Fish.startedAt = os.clock()
	Fish.lastSendAt = os.clock()
	Fish.restUntil = 0

	-- The game shows the first target after SPEEDUP_FIRST_DELAY, so an earlier tap is wasted.
	local cfg = Fn.getModule("FishCfg") or {}
	Fish.nextTapAt = os.clock() + (tonumber(cfg.SPEEDUP_FIRST_DELAY) or 0.8) + 0.2

	local hrp = Fn.getHRP()
	if hrp then
		Fish.good = { world = Fn.currentWorld(), position = hrp.Position, look = hrp.Position + hrp.CFrame.LookVector * 10 }
	end
end

function Fn.stopFishing(reason)
	if Fish.active then Fn.invoke("FishingService", "StopFishing") end
	Fish.active = false
	if reason then Fish.lastStop = reason end
end

pcall(function()
	local caught = Fn.knitRemote("FishingService", "RE", "Caught")
	if caught then
		caught.OnClientEvent:Connect(function(item, endsAt, _, catchNumber)
			Fish.caught = Fish.caught + 1
			Stats.fish = Stats.fish + 1
			if type(item) == "table" then
				Fish.lastCatch = string.format("%s %s x%s", tostring(item.Kind), tostring(item.Name), tostring(item.Amount or 1))
			end
			-- Every catch also says when the next cast ends and how many this session has made.
			if tonumber(endsAt) then Fish.endsAt = tonumber(endsAt) end
			if tonumber(catchNumber) then Fish.catches = tonumber(catchNumber) end
		end)
	end

	-- The server ends a session when we move too far or leave; just note it and restart.
	local stopped = Fn.knitRemote("FishingService", "RE", "Stopped")
	if stopped then
		stopped.OnClientEvent:Connect(function(reason)
			Fish.active = false
			Fish.lastStop = "ended: " .. tostring(reason)
		end)
	end

	-- A session the game carries over (after a rejoin, say) is picked up as it is.
	local resumed = Fn.knitRemote("FishingService", "RE", "Resumed")
	if resumed then
		resumed.OnClientEvent:Connect(function()
			task.spawn(function()
				local session = Fn.getSession()
				if session then
					Fn.adoptSession(session)
					Fish.lastStop = ""
				end
			end)
		end)
	end
end)

-- Finding a place to fish -------------------------------------------------------
-- The game offers a fishing prompt (a part named FishingPrompt under the camera)
-- only where water is within reach, and pressing it is what opens the fishing HUD,
-- which starting through the remote does not. So water is found by walking
-- somewhere likely and watching for that prompt. The first spot where it appears
-- is saved, per world, and used directly from then on.

-- The three worlds the game lets you fish in, each with the decor piece that
-- marks a good place to stand (its position in the world's Decors folder).
local FISH_SPOTS = {
	-- `pos` is the default fishing position for the world; `index` (the decor marker) is only
	-- used when there is no `pos`, since positions do not drift the way a child index can.
	Spawn         = { label = "Spawn",          path = { "Map", "Worlds", "Spawn", "Decors" },           index = 160, pos = Vector3.new(-33, 18, 4) },
	TreasureDunes = { label = "Treasure Dunes", path = { "Map", "Worlds", "TreasureDunes", "Decors" },   index = 371, pos = Vector3.new(1112, 3, -1617) },
	HauntedHouse  = { label = "Haunted House",  path = { "Map", "Worlds", "Haunted House", "Decors" },   index = 164, pos = Vector3.new(2420, 2, -2876) },
}

-- A dropdown label, or a world name from an older save, as a world key.
function Fn.fishWorldKey(value)
	if FISH_SPOTS[value] then return value end
	for key, spot in pairs(FISH_SPOTS) do
		if spot.label == value then return key end
	end
	return "Spawn"
end

-- Saved spots -----------------------------------------------------------------

local SPOT_FOLDER = "NisulRocks PU"
local SPOT_FILE = SPOT_FOLDER .. "/FishingSpots.json"
local SavedSpots = {} -- world -> Vector3

function Fn.loadSpots()
	if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
	pcall(function()
		if not isfile(SPOT_FILE) then return end
		local data = HttpService:JSONDecode(readfile(SPOT_FILE))
		for world, p in pairs(data) do
			if FISH_SPOTS[world] and type(p) == "table" and tonumber(p.x) and tonumber(p.y) and tonumber(p.z) then
				SavedSpots[world] = Vector3.new(p.x, p.y, p.z)
			end
		end
	end)
end

function Fn.saveSpots()
	if typeof(writefile) ~= "function" then return end
	pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SPOT_FOLDER) then
			makefolder(SPOT_FOLDER)
		end
		local data = {}
		for world, pos in pairs(SavedSpots) do data[world] = { x = pos.X, y = pos.Y, z = pos.Z } end
		writefile(SPOT_FILE, HttpService:JSONEncode(data))
	end)
end

Fn.loadSpots()

-- Where the chosen world's decor marker is, waiting a little for it to load.
-- Returns the position, or nil plus a reason.
function Fn.fishSpotTarget(world, abort)
	local spot = FISH_SPOTS[world]
	if not spot then return nil, "no spot set for " .. tostring(world) end
	if spot.pos then return spot.pos end

	local inst, count
	for _ = 1, 12 do
		local decors = Fn.instanceAtPath(spot.path)
		local children = decors and decors:GetChildren() or {}
		count = #children
		inst = children[spot.index]
		if inst or abort() then break end
		task.wait(0.5)
	end
	if not inst then return nil, string.format("decor #%d not found (%d decors)", spot.index, count or 0) end

	local pos
	if inst:IsA("Model") then
		pos = inst:GetPivot().Position
	elseif inst:IsA("BasePart") then
		pos = inst.Position
	else
		local part = inst:FindFirstChildWhichIsA("BasePart", true)
		pos = part and part.Position
	end
	if not pos then return nil, "decor #" .. spot.index .. " has no position" end
	return pos
end

-- The fishing prompt ----------------------------------------------------------

-- Workspace.CurrentCamera.FishingPrompt sits at its default spot, away from the
-- player, until there is water in reach; then it comes to within about a stud of
-- the player. Anything past a few studs is the default spot, not water.
local PROMPT_NEAR = 5

function Fn.partPosition(part)
	if part:IsA("BasePart") then return part.Position end
	local ok, pos = pcall(function() return part:GetPivot().Position end)
	return ok and pos or nil
end

-- The prompt part and its position when it is close to the player (water in reach), else nil.
function Fn.fishingPrompt()
	local camera = Workspace.CurrentCamera
	local part = camera and camera:FindFirstChild("FishingPrompt")
	local hrp = Fn.getHRP()
	if not (part and hrp) then return nil end

	local pos = Fn.partPosition(part)
	if pos and (pos - hrp.Position).Magnitude <= PROMPT_NEAR then return part, pos end
	return nil
end

-- Where the prompt is, for the status line when nothing shows up.
function Fn.promptDescription()
	local camera = Workspace.CurrentCamera
	local part = camera and camera:FindFirstChild("FishingPrompt")
	local hrp = Fn.getHRP()
	if not part then return "no FishingPrompt part under the camera" end
	local pos = Fn.partPosition(part)
	if not (pos and hrp) then return "FishingPrompt has no position" end
	return string.format("FishingPrompt is %d studs away", math.floor((pos - hrp.Position).Magnitude))
end

-- Taps the prompt on screen, as a player would. `attempt` 1 taps the spot as the camera
-- projects it, 2 shifts it down by the top-bar inset (executors differ on which they
-- expect), 3 sends a touch instead of a mouse click. The camera is turned to face the
-- prompt for the tap when it is off screen, then handed back.
function Fn.pressFishingPrompt(attempt)
	local part, pos = Fn.fishingPrompt()
	if not part then return false end

	local camera = Workspace.CurrentCamera
	local gotVim, vim = pcall(function() return game:GetService("VirtualInputManager") end)
	if not (camera and gotVim and vim) then return false end

	local savedType = camera.CameraType
	local turned = false
	local v, onScreen = camera:WorldToViewportPoint(pos)
	if not onScreen or v.Z <= 0 then
		turned = true
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, pos)
		task.wait(0.15)
		v, onScreen = camera:WorldToViewportPoint(pos)
	end

	local tapped = false
	if onScreen and v.Z > 0 then
		local x, y = v.X, v.Y
		if attempt == 2 then
			local okInset, inset = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
			if okInset then y = y + inset.Y end
		end

		if attempt == 3 then
			tapped = pcall(function()
				vim:SendTouchEvent(1, 0, x, y)
				task.wait(0.06)
				vim:SendTouchEvent(1, 2, x, y)
			end)
		else
			tapped = pcall(function()
				vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
				task.wait(0.06)
				vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
			end)
		end
	end

	if turned then
		task.wait(0.3)
		camera.CameraType = savedType
	end
	return tapped
end

-- Presses the prompt and waits for the game to open fishing (FishingActive), then
-- follows the session it started. True once fishing is under way.
function Fn.startByPrompt(abort)
	for attempt = 1, 3 do
		if abort and abort() then return false end
		if not Fn.fishingPrompt() then return false end -- the water went out of reach
		Fn.pressFishingPrompt(attempt)

		local deadline = os.clock() + 3
		while os.clock() < deadline do
			if abort and abort() then return false end
			if LocalPlayer:GetAttribute("FishingActive") then
				local session = Fn.getSession()
				if session then Fn.adoptSession(session) end
				Fish.active = true
				Fn.sessionStarted()
				return true
			end
			task.wait(0.2)
		end
	end
	return false
end

-- Gets us fishing: follow a session that is already running, press the prompt if we
-- are already at water, or go to the world's fishing spot (the saved one, then the
-- decor marker) and press it the moment it appears. The spot where it appears is
-- saved for next time. `abort` ends it early (toggle off, or something outranks fishing).
function Fn.acquireAndStart(abort)
	if LocalPlayer:GetAttribute("FishingActive") then
		local session = Fn.getSession()
		if session then
			Fn.adoptSession(session)
			Fish.lastStop = ""
			return true
		end
	end

	local world = Fn.fishWorldKey(State.fishWorld)

	local function remember()
		local hrp = Fn.getHRP()
		if hrp and Fn.currentWorld() == world then
			-- The default position needs no copy; only a different spot is worth saving.
			local default = FISH_SPOTS[world].pos
			if default and (hrp.Position - default).Magnitude < 3 then return end
			SavedSpots[world] = hrp.Position
			Fn.saveSpots()
		end
	end

	-- Already at water (the prompt is up)?
	if Fn.fishingPrompt() and Fn.currentWorld() == world then
		if not SavedSpots[world] then remember() end
		if Fn.startByPrompt(abort) then return true end
	end

	if Fn.isWorldOwned(world) == false then
		Fish.lastStop = "the " .. Fn.worldLabel(world) .. " world is not unlocked yet"
		return false
	end
	if Fn.currentWorld() ~= world and not Fn.travelToWorld(world, nil, abort) then
		Fish.lastStop = "could not get to " .. Fn.worldLabel(world)
		return false
	end

	-- Where to look: the saved spot first, and always the world's default position
	-- as the next stop whenever the prompt does not come into range.
	local targets = {}
	if SavedSpots[world] then targets[#targets + 1] = { pos = SavedSpots[world], saved = true } end
	local decor, why = Fn.fishSpotTarget(world, abort)
	if decor then targets[#targets + 1] = { pos = decor } end
	if #targets == 0 then
		Fish.lastStop = "no fishing spot known for " .. Fn.worldLabel(world) .. " (" .. tostring(why) .. ")"
		return false
	end

	for _, target in ipairs(targets) do
		if abort() then return false end
		Fish.lastStop = "going to the fishing spot..."

		-- Walk there, but stop the moment the game offers the prompt: that is water.
		Fn.teleportTo(Fn.groundAt(target.pos), 3, 15, function()
			return abort() or Fn.fishingPrompt() ~= nil
		end)
		if abort() then return false end

		-- A moment for the prompt to show on arrival.
		local deadline = os.clock() + 3
		while not Fn.fishingPrompt() and os.clock() < deadline and not abort() do task.wait(0.2) end

		if Fn.fishingPrompt() then
			remember()
			if Fn.startByPrompt(abort) then return true end
			-- The prompt is up but pressing it did not open fishing: ask the server directly.
			if Fn.startFishing() then return true end
		end

		-- This spot did not give us fishing. A remembered one is forgotten, so the next try
		-- goes to the default position instead of coming back here.
		if target.saved then
			SavedSpots[world] = nil
			Fn.saveSpots()
		end
	end

	Fish.lastStop = "no fishing prompt appeared at the fishing spot (" .. Fn.promptDescription() .. ")"
	return false
end

-- Main loop -------------------------------------------------------------------

function Fn.tapOnce()
	local now = os.clock()
	if now < (Fish.nextTapAt or 0) or now < Fish.restUntil then return end

	local cfg = Fn.getModule("FishCfg") or {}
	local minGap = tonumber(cfg.SPEEDUP_MIN_INTERVAL) or 0.2

	local plan = TAP_PLANS[Fish.plan]

	-- A person needs a moment between a target appearing and tapping it, and the server
	-- bans taps that arrive instantly. A short random pause comes first; the index is
	-- read after it, right before sending, because the index keeps moving.
	task.wait(0.08 + math.random() * 0.12)
	local index = Fn.currentIndex()
	if plan.idx == "fresh1" then
		index = index + 1
	elseif plan.idx == "reply" and Fish.replyIndex then
		index = Fish.replyIndex
	end

	local clicks = plan.clicks or nil

	local found, x, y = pcall(Fn.tapTarget, index)
	if not found then x, y = nil, nil end
	if not x then
		Fish.lastReply = "the tap sequence gave no target for index " .. tostring(index)
		Fn.nextPlan()
		Fish.nextTapAt = now + 0.2
		return
	end

	Fish.lastTap = { x, y }
	Fish.sent = Fish.sent + 1
	Fish.lastSendAt = now
	Fish.lastSent = string.format("index %d, x %.3f, y %.3f, clicks %s", index, x, y, clicks and tostring(clicks) or "none")

	-- FishingService.RF.SpeedUp:InvokeServer(tapIndex, x, y, clicks)
	local ok, res
	if clicks then
		ok, res = Fn.invoke("FishingService", "SpeedUp", index, x, y, clicks)
	else
		ok, res = Fn.invoke("FishingService", "SpeedUp", index, x, y)
	end
	local r = res[1]

	if type(r) == "table" then
		if type(r.TapIndex) == "number" then
			Fish.index, Fish.replyIndex, Fish.replyAt = r.TapIndex, r.TapIndex, os.clock()
		end
		if tonumber(r.EndsAt) then Fish.endsAt = tonumber(r.EndsAt) end

		if r.Accepted then
			Fish.accepted = Fish.accepted + 1
			Fish.rejects, Fish.planRejects, Fish.cycled = 0, 0, 0
			Fish.won = true
			Fish.streak = tonumber(r.Streak) or Fish.streak
			-- Tap at the player's chosen pace, never faster than the server's minimum gap.
			-- (with a little random variation, so the rhythm is not metronome-perfect)
			Fish.nextTapAt = os.clock() + math.max(minGap, State.fishTapInterval) * (0.9 + math.random() * 0.3)
			return
		end
	end

	-- Rejected or unanswered. A tap can miss because the target moved on while it was in
	-- flight, so a few misses are normal; several in a row means this way of sending is
	-- wrong, and the next one is tried. Keep the server's words for the status line.
	Fish.lastReply = Fn.describe(r)
	Fish.nextTapAt = os.clock() + (Fish.won and 1.2 or math.max(1, State.fishTapInterval))
	Fish.rejects = Fish.rejects + 1
	Fish.planRejects = Fish.planRejects + 1
	if Fish.planRejects >= (Fish.won and 6 or 3) then Fn.nextPlan() end

	Fish.failStreak = Fish.failStreak + (ok and 0 or 1)
	if not ok and Fish.failStreak >= 4 then
		Fish.active = false
		Fish.failStreak = 0
		Fish.lastStop = "session stopped answering"
	end
end

function Fn.fishStatus()
	if not Fish.active then return Fish.lastStop ~= "" and Fish.lastStop or "not fishing" end

	local left = Fish.endsAt and math.max(0, Fish.endsAt - Workspace:GetServerTimeNow())
	local text = string.format("fishing | caught %d%s | streak %d | last: %s%s",
		Fish.caught, Fish.catches and (" (session " .. Fish.catches .. ")") or "", Fish.streak, Fish.lastCatch,
		left and string.format(" | next catch in %.0fs", left) or "")

	if os.clock() < Fish.restUntil then
		text = text .. string.format("\ntaps paused %.0fs: the server is not taking them, the cast finishes by itself",
			Fish.restUntil - os.clock())
	else
		text = text .. string.format("\ntaps %d/%d accepted | %s", Fish.accepted, Fish.sent, Fn.planText(TAP_PLANS[Fish.plan]))
	end
	if Fish.rejects > 0 then
		text = text .. string.format("\nrejected %dx - server said: %s\nsent: %s", Fish.rejects, tostring(Fish.lastReply), Fish.lastSent)
	end
	return text
end

function Fn.fishStep()
	local function abort() return not State.autoFish or Fn.held("fish") ~= nil end

	local blocker = Fn.held("fish")
	if blocker then
		if Fish.active then Fn.stopFishing("paused - " .. blocker .. " has priority") end
		Fn.setFeature("fishing", "paused - " .. blocker .. " has priority")
		return
	end

	-- Hatching and best-world teleport hold off only while we are actually fishing
	-- or about to; a failed search releases them for a while.
	if os.clock() < Fish.pauseUntil then
		Fn.setClaim("fish", false)
		Fn.setFeature("fishing", Fn.fishStatus() .. " (retrying shortly)")
		return
	end
	Fn.setClaim("fish", true)

	-- The game keeps a session running by itself; follow it rather than starting another
	-- (which would mean walking off and ending it).
	if not Fish.active and LocalPlayer:GetAttribute("FishingActive") then
		local session = Fn.getSession()
		if session then
			Fn.adoptSession(session)
			Fish.lastStop = ""
		end
	end

	-- A session that the server no longer shows as active is over.
	if Fish.active and not LocalPlayer:GetAttribute("FishingActive") then
		Fish.inactiveSince = Fish.inactiveSince or os.clock()
		if os.clock() - Fish.inactiveSince > 4 then
			Fish.active = false
			Fish.inactiveSince = nil
			Fish.lastStop = "session ended"
		end
	else
		Fish.inactiveSince = nil
	end

	if not Fish.active then
		if Fn.acquireAndStart(abort) then
			Fish.failStreak = 0
		else
			Fish.failStreak = Fish.failStreak + 1
			if Fish.failStreak >= 2 and State.autoFish then
				Fish.failStreak = 0
				Fish.pauseUntil = os.clock() + 30
			end
		end
		Fn.setFeature("fishing", Fn.fishStatus())
		return
	end

	Fn.tapOnce()

	-- Worms and hooks wear off, so top them up now and then while a session runs.
	if State.autoFishBoosts and useFishBoostsHook and os.clock() - (Fish.boostCheck or 0) > 10 then
		Fish.boostCheck = os.clock()
		pcall(useFishBoostsHook)
	end
	Fn.setFeature("fishing", Fn.fishStatus())
end

Fn.runLoop("Fishing", function() return State.autoFish end, Fn.fishStep,
	function() return Fish.active and math.clamp(State.fishTapInterval, 0.4, 2) or 1.5 end, 0.15)

-- Leaves the session cleanly the moment the toggle goes off.
function Fn.setAutoFish(on)
	State.autoFish = on
	if not on then
		Fn.stopFishing("switched off")
		Fn.setClaim("fish", false)
		Fish.pauseUntil = 0
		Fn.setFeature("fishing", "switched off")
	end
end

-- "Fish Here": start (and remember) a session exactly where we stand.
function Fn.fishHere()
	if Fish.active then Fn.setFeature("fishing", "already fishing") return end
	if Fn.startByPrompt(function() return false end) or Fn.startFishing() then
		Fn.setFeature("fishing", "session started here - turn Auto Fish on to keep it going")
	else
		Fn.setFeature("fishing", Fish.lastStop)
	end
end

