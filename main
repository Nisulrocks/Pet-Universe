local ModuleCache = {}

function Fn.getModule(key)
	local cached = ModuleCache[key]
	if cached ~= nil then return cached or nil end
	local ok, inst = pcall(ModuleSources[key])
	local mod = false
	if ok and inst then
		local reqOk, result = pcall(require, inst)
		if reqOk and result ~= nil then mod = result end
	end
	ModuleCache[key] = mod
	return mod or nil
end

-- Per-player data lives behind the game's own PlayerData module, which reads
-- the copy mirrored under ReplicatedFirst.PlayerDataMirror. Fall back to that
-- mirror directly if the module ever stops answering.
function Fn.dataFolder(name)
	local pd = Fn.getModule("PlayerData")
	if pd and pd.Folder then
		local ok, folder = pcall(pd.Folder, LocalPlayer, name)
		if ok and folder then return folder end
	end
	local mirror = ReplicatedFirst:FindFirstChild("PlayerDataMirror")
	return mirror and mirror:FindFirstChild(name) or nil
end

-----------------------------------------------------------
-- REMOTE LAYER (Knit services)
-----------------------------------------------------------

-- Services are reached through the game's own SafeGetService helper, which is
-- what its client scripts do. If that ever breaks, fall back to the raw
-- Knit.Services.<Name>.RE / .RF remotes so one module change cannot kill us.
function Fn.rawService(name)
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knit = packages and packages:FindFirstChild("Knit")
	local services = knit and knit:FindFirstChild("Services")
	local folder = services and services:FindFirstChild(name)
	if not folder then return nil end

	local re, rf = folder:FindFirstChild("RE"), folder:FindFirstChild("RF")
	local proxy
	proxy = setmetatable({}, {
		__index = function(_, key)
			local ev = re and re:FindFirstChild(key)
			if ev and ev:IsA("RemoteEvent") then
				return { Fire = function(_, ...) ev:FireServer(...) end }
			end
			local fn = rf and rf:FindFirstChild(key)
			if fn and fn:IsA("RemoteFunction") then
				return function(...)
					local args = table.pack(...)
					local first = (args[1] == proxy) and 2 or 1
					return fn:InvokeServer(table.unpack(args, first, args.n))
				end
			end
			return nil
		end,
	})
	return proxy
end

local ServiceCache = {}

function Fn.GetSvc(name, methods)
	local cacheKey = name .. "|" .. (methods and table.concat(methods, ",") or "")
	local cached = ServiceCache[cacheKey]
	if cached then return cached end

	local svc
	local safe = Fn.getModule("SafeGet")
	if safe and safe.Get then
		local ok, result = pcall(safe.Get, name, methods)
		if ok and result then svc = result end
	end
	svc = svc or Fn.rawService(name)

	if svc then ServiceCache[cacheKey] = svc end
	return svc
end

-- Straight to Knit.Services.<Name>.RE.<Remote>:FireServer, exactly as the game's
-- own scripts send it. Returns false if the remote does not exist.
function Fn.fireRaw(serviceName, remoteName, ...)
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knit = packages and packages:FindFirstChild("Knit")
	local services = knit and knit:FindFirstChild("Services")
	local folder = services and services:FindFirstChild(serviceName)
	local re = folder and folder:FindFirstChild("RE")
	local ev = re and re:FindFirstChild(remoteName)
	if not (ev and ev:IsA("RemoteEvent")) then return false end

	local args = table.pack(...)
	local ok, err = pcall(function() ev:FireServer(table.unpack(args, 1, args.n)) end)
	if not ok then Fn.logError(serviceName .. "." .. remoteName, err) end
	return ok
end

-- The raw remote first: it is the one call whose arguments are certain. The
-- service wrapper is only a fallback if the remote cannot be found.
function Fn.fire(serviceName, remoteName, ...)
	local args = table.pack(...)
	if Fn.fireRaw(serviceName, remoteName, table.unpack(args, 1, args.n)) then return true end

	return (pcall(function()
		local svc = Fn.GetSvc(serviceName)
		local ev = svc and svc[remoteName]
		if not ev then error("remote missing") end
		ev:Fire(table.unpack(args, 1, args.n))
	end))
end

-- Instance for a Knit remote, e.g. knitRemote("CodesService", "RE", "Result").
function Fn.knitRemote(serviceName, kind, remoteName)
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knit = packages and packages:FindFirstChild("Knit")
	local services = knit and knit:FindFirstChild("Services")
	local folder = services and services:FindFirstChild(serviceName)
	local group = folder and folder:FindFirstChild(kind)
	return group and group:FindFirstChild(remoteName)
end

-- Calls a RemoteFunction. Returns (ok, packedResults); on failure the first
-- packed value is the error text, which callers can show.
--
-- This goes straight to remote:InvokeServer(...). Knit's service wrappers are
-- called with a leading `self`, so calling one without it shifts every argument
-- one place (SpeedUp(index, x, y) would reach the server as (x, y)).
function Fn.invoke(serviceName, remoteName, ...)
	local args = table.pack(...)

	local remote = Fn.knitRemote(serviceName, "RF", remoteName)
	if remote and remote:IsA("RemoteFunction") then
		local r = table.pack(pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n)))
		if r[1] then return true, table.pack(table.unpack(r, 2, r.n)) end
		return false, table.pack(tostring(r[2]))
	end

	-- Remote not found: try the wrapper, as a method call and then as a plain call.
	local svc = Fn.GetSvc(serviceName)
	local fn = svc and svc[remoteName]
	if type(fn) == "function" then
		local r = table.pack(pcall(fn, svc, table.unpack(args, 1, args.n)))
		if r[1] then return true, table.pack(table.unpack(r, 2, r.n)) end
		r = table.pack(pcall(fn, table.unpack(args, 1, args.n)))
		if r[1] then return true, table.pack(table.unpack(r, 2, r.n)) end
	end
	return false, table.pack("remote not found")
end

-- Not every remote's argument format is known up front. Each "form" is a
-- function that sends one candidate call; verify() reads the game's own data to
-- confirm the server acted. The first form that verifies is remembered, so
-- later calls skip straight to it instead of guessing again.
--
-- `abort` ends the attempt at once (a switched-off feature must never be left
-- waiting on a slow probe), and a label that found no working form rests for a
-- while instead of re-probing every pass.
local ProbeCache = {}
local ProbeFailedAt = {}

function Fn.tryForms(label, forms, verify, ctx, settle, abort, skipRest)
	local order = {}
	if ProbeCache[label] then
		order[1] = ProbeCache[label]
	else
		if not skipRest and os.clock() - (ProbeFailedAt[label] or -math.huge) < 60 then return false end
		for i = 1, #forms do order[i] = i end
	end

	for _, i in ipairs(order) do
		if not Fn.alive() or (abort and abort()) then return false end
		pcall(forms[i], ctx)

		local deadline = os.clock() + (settle or 2)
		repeat
			task.wait(0.25)
			if abort and abort() then return false end
			if verify() then
				ProbeCache[label] = i
				return true
			end
		until os.clock() >= deadline
	end

	if not ProbeCache[label] then ProbeFailedAt[label] = os.clock() end
	return false
end

-- Last thing each feature did, shown on the Rewards / World Tasks tabs.
local FeatureStatus = {}

function Fn.setFeature(key, text)
	FeatureStatus[key] = text
end

