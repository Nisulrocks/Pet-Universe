-----------------------------------------------------------
-- PRIORITY + TRAVEL
-----------------------------------------------------------

-- Anything that moves the character, or needs it to stand somewhere, is a task.
-- A task raises a claim while it has work, and every task stands down while a
-- claim that outranks it is up. That is what stops two features dragging the
-- character in opposite directions.
local Claims = {}

-- task -> the claims that outrank it. "errand" is a one-off trip (special
-- upgrade, fruit machine, Ben hunt): it outranks the long-running tasks, or it
-- would never get a turn while hatching is on, but yields to the alien egg and
-- crafting. Hatching and clicking breakables can share one spot, so they are
-- allowed to run together.
local OUTRANKED_BY = {
	alien     = {},
	craft     = { "alien" },
	errand    = { "alien", "craft" },
	index     = { "alien", "craft", "errand" },
	fish      = { "alien", "craft", "errand", "index" },
	hatch     = { "alien", "craft", "errand", "index", "fish" },
	farm      = { "alien", "craft", "errand" },
	bestworld = { "alien", "craft", "errand", "index", "fish", "hatch" },
}

function Fn.setClaim(name, on)
	Claims[name] = on and true or nil
end

-- Returns the claim holding this task back, or nil when it is free to run.
function Fn.held(name)
	for _, other in ipairs(OUTRANKED_BY[name] or {}) do
		if Claims[other] then return other end
	end
	return nil
end

-- The game files some worlds under a shorter name (Haunted) than the zone
-- attribute uses (HauntedHouse).
local WORLD_ALIASES = { Haunted = "HauntedHouse", HauntedHouse = "Haunted" }

function Fn.currentWorld()
	return LocalPlayer:GetAttribute("WorldZone")
end

-- true / false when ownership is known, nil when the data has not loaded yet.
function Fn.isWorldOwned(world)
	if world == "Spawn" then return true end
	local owned = Fn.dataFolder("WorldsData")
	if not owned then return nil end
	local flag = owned:FindFirstChild(world)
	if not flag and WORLD_ALIASES[world] then flag = owned:FindFirstChild(WORLD_ALIASES[world]) end
	return flag ~= nil and flag.Value == true
end

-- Egg data files Haunted House as "Haunted"; the zone attribute says "HauntedHouse".
function Fn.normWorld(world)
	if world == "Haunted" then return "HauntedHouse" end
	return world
end

-- Worlds that refused a teleport recently (locked, or the server said no), so a
-- loop does not hammer the remote every tick.
local worldCooldown = {}

-- Minimum gap between any two moves (world teleport or hop); see teleportTo.
local HOP_GAP = 2.5
local lastHop = -math.huge

-- The server's verdict on a teleport request, so a refusal can be reported.
local denial = { at = -math.huge, why = "" }

task.spawn(function()
	local remote
	for _ = 1, 20 do
		remote = Fn.knitRemote("TeleportService", "RE", "GoToDenied")
		if remote or not Fn.alive() then break end
		task.wait(1)
	end
	if remote and remote:IsA("RemoteEvent") then
		remote.OnClientEvent:Connect(function(...)
			denial.at = os.clock()
			local parts = {}
			for _, v in ipairs({ ... }) do parts[#parts + 1] = tostring(v) end
			denial.why = table.concat(parts, " ")
		end)
	end
end)

function Fn.recentDenial(since)
	if denial.at >= since then return denial.why ~= "" and denial.why or "no reason given" end
	return nil
end

-- World travel always goes through the game's own teleport (TeleportService.GoTo),
-- the same call its world menu makes. No coordinate jumps. Returns true once the
-- zone confirms, false if the world would not take us.
function Fn.travelToWorld(world, timeout, abort)
	world = Fn.normWorld(world)
	if Fn.currentWorld() == world then return true end
	if Fn.isWorldOwned(world) == false then return false end
	if (worldCooldown[world] or 0) > os.clock() then return false end

	for _ = 1, 3 do
		if not Fn.alive() or (abort and abort()) then return false end
		lastHop = os.clock()
		local askedAt = os.clock()
		Fn.fire("TeleportService", "GoTo", world)

		local deadline = os.clock() + (timeout or 5)
		while os.clock() < deadline and Fn.alive() do
			if abort and abort() then return false end -- cancelled: no cooldown, it was not refused
			if Fn.currentWorld() == world then
				task.wait(0.6) -- let the character land and the world stream in
				lastHop = os.clock() -- the next hop waits its turn after the world teleport
				return true
			end
			local why = Fn.recentDenial(askedAt)
			if why then
				Fn.setFeature("move", "world teleport to " .. world .. " refused: " .. why)
				break
			end
			task.wait(0.25)
		end
	end

	worldCooldown[world] = os.clock() + 30
	return false
end

-----------------------------------------------------------
-- TELEPORTING
-----------------------------------------------------------

-- Snaps a point to the floor beneath it: eggs float, and a mid-air goal would
-- drop us in the sky. Only solid surfaces count, so a beam, a decal part or a
-- roof we cannot stand on never becomes the "floor".
function Fn.groundAt(pos, extraIgnore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	pcall(function() params.RespectCanCollide = true end)
	local ignore = { LocalPlayer.Character }
	for _, inst in ipairs(extraIgnore or {}) do ignore[#ignore + 1] = inst end
	for _, name in ipairs({ "PlayerPets", "Breakables", "Orbs", "EggHatchVisuals" }) do
		local f = Workspace:FindFirstChild(name)
		if f then ignore[#ignore + 1] = f end
	end
	params.FilterDescendantsInstances = ignore

	local hit = Workspace:Raycast(pos + Vector3.new(0, 14, 0), Vector3.new(0, -200, 0), params)
	return hit and (hit.Position + Vector3.new(0, 3, 0)) or pos
end

function Fn.flatDistance(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

-- Places the character. The whole model is moved, and anything that would fight
-- a CFrame set (a seat, PlatformStand, an anchor) is cleared first.
function Fn.placeAt(dest)
	local char, hrp = LocalPlayer.Character, Fn.getHRP()
	if not (char and hrp) then return false end
	return (pcall(function()
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Sit = false
			hum.PlatformStand = false
		end
		hrp.Anchored = false
		char:PivotTo(CFrame.new(dest))
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end))
end

-- With streaming on, the ground at a far point may not exist yet: arrive before
-- it loads and we fall through the world.
function Fn.streamIn(pos)
	if not Workspace.StreamingEnabled then return end
	pcall(function() LocalPlayer:RequestStreamAroundAsync(pos, 3) end)
end

-- Jumps to `dest` and watches what the game does about it. A server that
-- rejects the move puts us back where we came from a moment later, and a
-- missing floor drops us out of the sky; both are told apart from success.
-- Returns "ok", "snapped" or "fell".
function Fn.hopTo(dest, abort)
	local from = Fn.getHRP() and Fn.getHRP().Position
	Fn.streamIn(dest)
	if not Fn.placeAt(dest) then return "snapped" end

	local deadline = os.clock() + 1.2
	repeat
		task.wait(0.2)
		if not Fn.alive() or (abort and abort()) then return "snapped" end
		local h = Fn.getHRP()
		if not h then return "snapped" end
		if h.Position.Y < dest.Y - 60 then return "fell" end
		if (h.Position - dest).Magnitude > 30 then
			return (from and (h.Position - from).Magnitude < 30) and "snapped" or "fell"
		end
	until os.clock() >= deadline
	return "ok"
end

-- The server rubber-bands any jump of real distance, so getting anywhere on foot
-- is done the way a player does it: a computed path around the scenery, walked
-- at the game's own speed. Gets unstuck by jumping and re-planning.
local PathfindingService = game:GetService("PathfindingService")

-- Only the walk that is still current may stop the character; a walk that was
-- cancelled by a higher-priority task must not cancel the one that replaced it.
local walkToken = 0

function Fn.haltWalk(token)
	if token ~= walkToken then return end
	local hrp = Fn.getHRP()
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum and hrp then pcall(function() hum:MoveTo(hrp.Position) end) end
end

-- Spots beside the target to path to when the target itself is unreachable (an
-- egg sits on a platform; a machine is solid).
function Fn.goalsAround(target)
	local goals = { target }
	for _, d in ipairs({ Vector3.new(7, 0, 0), Vector3.new(-7, 0, 0), Vector3.new(0, 0, 7), Vector3.new(0, 0, -7),
		Vector3.new(12, 0, 12), Vector3.new(-12, 0, -12) }) do
		goals[#goals + 1] = target + d
	end
	return goals
end

-- Returns true on arrival, or false plus a short reason.
function Fn.walkTo(target, stop, abort)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = Fn.getHRP()
	if not (hum and hrp) then return false, "no character" end
	pcall(function() hum.Sit = false end)
	Fn.streamIn(target)

	walkToken = walkToken + 1
	local mine = walkToken

	local speed = math.max(hum.WalkSpeed, 10)
	local limit = math.clamp((target - hrp.Position).Magnitude / speed * 2.2 + 10, 12, 70)
	local startedAt = os.clock()
	local plans, reason = 0, "timed out"

	local function stopped()
		return not Fn.alive() or (abort and abort()) or os.clock() - startedAt > limit
	end

	while not stopped() do
		hrp = Fn.getHRP()
		if not hrp then return false, "no character" end
		if Fn.flatDistance(hrp.Position, target) <= stop then Fn.haltWalk(mine) return true end

		-- Plan to the target, or to the first spot beside it that has a path.
		local waypoints
		for _, goal in ipairs(Fn.goalsAround(target)) do
			local path = PathfindingService:CreatePath({
				AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 8,
			})
			local ok = pcall(function() path:ComputeAsync(hrp.Position, goal) end)
			if ok and path.Status == Enum.PathStatus.Success then
				waypoints = path:GetWaypoints()
				break
			end
			if stopped() then break end
		end

		plans = plans + 1
		if not waypoints or #waypoints < 2 then
			reason = "no path to the target"
			if plans >= 3 then break end
			task.wait(0.5)
		else
			local replan = false
			for i = 2, #waypoints do
				local wp = waypoints[i]
				if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
				hum:MoveTo(wp.Position)

				local lastPos, lastMoved, reached = hrp.Position, os.clock(), os.clock()
				while true do
					task.wait(0.1)
					if stopped() then break end
					hrp = Fn.getHRP()
					if not hrp then return false, "no character" end

					if Fn.flatDistance(hrp.Position, target) <= stop then Fn.haltWalk(mine) return true end
					if Fn.flatDistance(hrp.Position, wp.Position) <= 3.5 then break end

					if (hrp.Position - lastPos).Magnitude > 0.6 then
						lastPos, lastMoved = hrp.Position, os.clock()
					elseif os.clock() - lastMoved > 0.7 then
						hum.Jump = true -- snagged on something: hop over it
						if os.clock() - lastMoved > 1.8 then replan = true break end
					end
					if os.clock() - reached > 6 then replan = true break end
				end
				if replan or stopped() then break end
			end
			if replan then reason = "kept getting stuck" end
		end
	end

	Fn.haltWalk(mine)
	hrp = Fn.getHRP()
	if hrp and Fn.flatDistance(hrp.Position, target) <= stop then return true end
	return false, reason
end

-- Last resort for when walking cannot get there: the same speed as walking, in a
-- straight line, with the body made non-solid so scenery cannot stop it.
function Fn.glideTo(dest, abort)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hum and Fn.getHRP()) then return false end
	local speed = math.clamp(hum.WalkSpeed * 0.85, 12, 28)

	local solid = {}
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			solid[#solid + 1] = part
			part.CanCollide = false
		end
	end

	local startedAt, arrived = os.clock(), false
	local limit = (dest - Fn.getHRP().Position).Magnitude / speed + 6
	while Fn.alive() and os.clock() - startedAt < limit do
		if abort and abort() then break end
		local h = Fn.getHRP()
		if not h then break end
		local dt = RunService.Heartbeat:Wait()
		local offset = dest - h.Position
		local dist = offset.Magnitude
		if dist <= 2 then arrived = true break end
		pcall(function()
			h.CFrame = CFrame.new(h.Position + offset.Unit * math.min(dist, speed * dt))
			h.AssemblyLinearVelocity = Vector3.zero
		end)
	end

	for _, part in ipairs(solid) do pcall(function() part.CanCollide = true end) end
	return arrived
end

-- The game's own machine travel (the Fast Travel feature). Targets are keyed
-- "<World>/<Machine>"; the one whose machine sits at `target` is the one to ask for.
function Fn.instanceAtPath(path)
	local node = Workspace
	for _, name in ipairs(path) do
		node = node and node:FindFirstChild(name)
	end
	return node
end

function Fn.machineKeyNear(target)
	local cfg = Fn.getModule("FastTravel")
	local list = cfg and cfg.Targets
	if type(list) ~= "table" then return nil end
	for _, entry in ipairs(list) do
		if type(entry) == "table" and entry.Kind == "Machine" and type(entry.Key) == "string"
			and type(entry.Machine) == "table" then
			local inst = Fn.instanceAtPath(entry.Machine)
			local pos = inst and (inst:IsA("Model") and inst:GetPivot().Position
				or inst:IsA("BasePart") and inst.Position)
			if pos and (pos - target).Magnitude <= 80 then return entry.Key, inst end
		end
	end
	return nil
end

function Fn.fastTravelTo(target, stop, abort)
	local key, inst = Fn.machineKeyNear(target)
	if not key then return false end

	return Fn.tryForms("fastTravel", {
		function() Fn.fire("TeleportService", "GoToMachine", key) end,
		function() Fn.fire("TeleportService", "GoToMachine", inst) end,
		function() Fn.fire("TeleportService", "GoToMachine", { key }) end,
	}, function()
		local h = Fn.getHRP()
		return h ~= nil and Fn.flatDistance(h.Position, target) <= stop + 40
	end, nil, 2.5, abort)
end

-- Getting anywhere is the game's world teleport (travelToWorld) and then a walk
-- to the target. The server rubber-bands real jumps, so:
--   1. a short hop, only when the target is a few steps away
--   2. a pathfound walk around the scenery
--   3. the game's own machine travel, when the target is a machine
--   4. a walking-pace glide through the scenery
-- Each is checked against where the character actually ends up. `abort` ends
-- it at once. Returns true if we ended up at the target; the reason it did not
-- is left in the "move" status.
local SHORT_HOP = 25

function Fn.teleportTo(target, stop, _, abort)
	stop = stop or 6
	local hrp = Fn.getHRP()
	if not hrp then return false end
	if Fn.flatDistance(hrp.Position, target) <= stop then return true end

	local function aborted() return not Fn.alive() or (abort and abort()) end

	local function arrived()
		local h = Fn.getHRP()
		return h ~= nil and Fn.flatDistance(h.Position, target) <= stop + 6
	end

	local function waitTurn()
		while os.clock() - lastHop < HOP_GAP do
			if aborted() then return false end
			task.wait(0.1)
		end
		lastHop = os.clock()
		return not aborted()
	end

	local function destination()
		local h = Fn.getHRP()
		local away = h and (h.Position - target) or Vector3.new(1, 0, 0)
		away = Vector3.new(away.X, 0, away.Z)
		away = away.Magnitude > 1 and away.Unit or Vector3.new(1, 0, 0)
		return target + away * math.min(stop, 5) + Vector3.new(0, 3, 0)
	end

	-- 1. a few steps away: one hop is fine
	if Fn.flatDistance(hrp.Position, target) <= SHORT_HOP then
		if not waitTurn() then return false end
		if Fn.hopTo(destination(), abort) == "ok" and arrived() then
			Fn.setFeature("move", "ok")
			return true
		end
	end

	-- 2. walk
	Fn.setFeature("move", "walking")
	local ok, reason = Fn.walkTo(target, stop, abort)
	if ok then
		Fn.setFeature("move", "ok (walked)")
		return true
	end
	if aborted() then return false end

	-- 3. the game's machine travel, then the last few steps on foot
	if Fn.fastTravelTo(target, stop, abort) then
		lastHop = os.clock()
		if arrived() or Fn.walkTo(target, stop, abort) then
			Fn.setFeature("move", "ok (fast travel)")
			return true
		end
	end

	-- 4. glide
	if aborted() then return false end
	if Fn.glideTo(destination(), abort) and arrived() then
		Fn.setFeature("move", "ok (glide)")
		return true
	end

	Fn.setFeature("move", "could not reach target: " .. tostring(reason))
	return false
end

-- A saved spot to come back to: which world, and where in it.
function Fn.savePlace()
	local hrp = Fn.getHRP()
	if not hrp then return nil end
	return { world = Fn.currentWorld(), position = hrp.Position }
end

-- Back to a saved spot the same way we left: world teleport, then hop.
function Fn.returnToPlace(place, abort)
	if not place then return end
	if place.world and Fn.currentWorld() ~= place.world then
		if not Fn.travelToWorld(place.world, nil, abort) then return end
	end
	Fn.teleportTo(place.position, 6, nil, abort)
end

-----------------------------------------------------------
-- ERRANDS
-----------------------------------------------------------

-- A one-off trip: claim the player, let `work` go where it needs to, then come
-- home the way we left. `work(interrupted)` checks interrupted() between steps;
-- the alien egg or a crafting trip showing up ends the errand early. It shares
-- the crafting trip's lock, so two trips can never run at once.
local ERRAND_TIME_LIMIT = 150 -- no trip may hold the character longer than this

-- Why the running errand was cut short, so a trip that did nothing can say why.
local ErrandInfo = { stop = "" }

function Fn.errandTrip(label, work, wanted, limit)
	limit = limit or ERRAND_TIME_LIMIT
	if State.craftBusy or Fn.held("errand") then return false end
	if wanted ~= nil and not wanted() then return false end -- switched off before we even left
	ErrandInfo.stop = ""

	State.craftBusy = true
	Fn.setClaim("errand", true)

	local startedAt = os.clock()
	local okHome, home = pcall(Fn.savePlace)
	if not okHome then home = nil end

	local function outranked() return Fn.held("errand") ~= nil end
	local function switchedOff() return wanted ~= nil and not wanted() end
	-- Ends the trip when something outranks it, the feature that started it has
	-- been switched off, or it has simply run too long.
	local function interrupted()
		local by = Fn.held("errand")
		if by then ErrandInfo.stop = "outranked by " .. by return true end
		if switchedOff() then ErrandInfo.stop = "switched off" return true end
		if os.clock() - startedAt > limit then ErrandInfo.stop = "ran past the time limit" return true end
		return false
	end

	local ok, err = pcall(work, interrupted)

	-- Head home unless a higher-priority task now owns our position.
	if not outranked() then pcall(Fn.returnToPlace, home, outranked) end

	State.craftBusy = false
	Fn.setClaim("errand", false)
	if not ok then Fn.logError(label, err) end
	return ok
end

-----------------------------------------------------------
-- EVENTS
-----------------------------------------------------------

-- Mutations that only roll during an event (Wet in rain, UFO during an alien
-- invasion, Upside Down) are worth hatching for, so hatching can wait for them.
local EVENT_NAMES = { "Rainy (Wet mutation)", "Alien Invasion (UFO mutation)", "Upside Down" }

local EVENT_SOURCES = {
	["Rainy (Wet mutation)"]          = { admin = "WeatherRainy",         weather = "Rainy" },
	["Alien Invasion (UFO mutation)"] = { admin = "WeatherAlienInvasion", weather = "AlienInvasion", alien = true },
	["Upside Down"]                   = { admin = "UpsideDown" },
}

local EVENT_ALL = {}
for _, name in ipairs(EVENT_NAMES) do EVENT_ALL[name] = true end

local alienEventState = "Idle" -- kept current by the alien egg scan

-- Admin-run events store their end time (unix seconds) in AdminEventsState.
function Fn.adminEventActive(kind)
	local state = ReplicatedStorage:FindFirstChild("AdminEventsState")
	local v = state and state:FindFirstChild(kind)
	return v ~= nil and typeof(v.Value) == "number" and v.Value > Workspace:GetServerTimeNow()
end

-- The scheduled weather rotation lives in WeatherModule. Ask it what is active
-- and collect any weather ids that come back; the shape is not fixed, so a
-- list of ids, a keyed set and a single definition are all accepted.
function Fn.scheduledWeathers()
	local found = {}
	local mod = Fn.getModule("Weather")
	if not mod then return found end

	local function collect(v)
		if type(v) == "string" then
			found[v] = true
		elseif type(v) == "table" then
			if type(v.Id) == "string" then found[v.Id] = true end
			for k, item in pairs(v) do
				if type(item) == "string" then
					found[item] = true
				elseif item == true and type(k) == "string" then
					found[k] = true
				elseif type(item) == "table" and type(item.Id) == "string" then
					found[item.Id] = true
				end
			end
		end
	end

	for _, fnName in ipairs({ "GetActiveList", "GetCurrent" }) do
		local fn = mod[fnName]
		if type(fn) == "function" then
			for _, args in ipairs({ {}, { Workspace:GetServerTimeNow() } }) do
				local ok, res = pcall(fn, table.unpack(args))
				if ok and res ~= nil then collect(res) break end
			end
		end
	end
	return found
end

local ActiveEvents = {} -- event name -> true while it is running

function Fn.refreshEvents()
	local weathers = Fn.scheduledWeathers()
	local active = {}
	for name, src in pairs(EVENT_SOURCES) do
		if Fn.adminEventActive(src.admin)
			or (src.weather and weathers[src.weather])
			or (src.alien and alienEventState ~= "Idle") then
			active[name] = true
		end
	end
	ActiveEvents = active
end

-- Open when the toggle is off, or when any chosen event is running.
function Fn.eventGateOpen()
	if not State.hatchOnlyEvents then return true end
	local wanted = next(State.hatchEvents) and State.hatchEvents or EVENT_ALL
	for name in pairs(wanted) do
		if ActiveEvents[name] then return true end
	end
	return false
end

task.spawn(function()
	while Fn.alive() do
		pcall(Fn.refreshEvents)
		task.wait(2)
	end
end)

-- Hatching holds the player only while it is actually allowed to hatch, so
-- waiting for an event leaves everything else free to run.
task.spawn(function()
	while Fn.alive() do
		Fn.setClaim("hatch", State.autoHatch and Fn.eventGateOpen())
		task.wait(0.25)
	end
end)

-----------------------------------------------------------
-- BREAKABLES
-----------------------------------------------------------

local SKIP_BREAKABLES = { Apple = true, Banana = true, Blueberry = true, Kiwi = true, Mango = true, Taco = true }
local ALIEN_NAMES     = { AlienEventEgg = true, UFOEgg = true }

function Fn.eggPart(egg)
	if not (egg and egg.Parent) then return nil end
	if egg:IsA("Model") then
		return egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart", true)
	end
	return egg:IsA("BasePart") and egg or nil
end

-- HP and currency per breakable tier come from the game's own config. The
-- model carries its zone as an attribute; fall back to any world that has the tier.
function Fn.tierInfo(model)
	local cfg = Fn.getModule("BreakablesCfg")
	local worlds = cfg and cfg.Worlds
	if type(worlds) ~= "table" then return nil end

	local zone = model:GetAttribute("ZoneName")
	local world = zone and worlds[zone]
	local info = type(world) == "table" and world.Tiers and world.Tiers[model.Name]
	if info then return info end

	for _, w in pairs(worlds) do
		local t = type(w) == "table" and w.Tiers and w.Tiers[model.Name]
		if t then return t end
	end
	return nil
end

-- SetAutoBreaking is the game's own auto farm: pets chase and break targets by
-- themselves. The server drops it on a world change or respawn, so it is
-- re-sent every few seconds while farming instead of only on the toggle.
local builtInAuto, builtInSentAt = nil, 0

function Fn.ensureBuiltInAuto(on, force)
	if not force and builtInAuto == on and os.clock() - builtInSentAt < 8 then return end
	builtInAuto, builtInSentAt = on, os.clock()
	Fn.fireRaw("BreakableAreaService", "SetAutoBreaking", on)
end

-- Clicks beyond this are wasted (the detectors cap at 100 studs), so the
-- priority modes only consider breakables they can actually reach.
local CLICK_RANGE = 90

function Fn.clickStep()
	-- The alien egg and crafting trips outrank farming: pause the clicks and the
	-- pets' auto break until they are done.
	local blocker = Fn.held("farm")
	if blocker == "alien" and not (Claims.craft or Claims.errand) then
		-- The egg has our clicks; the pets keep farming.
		Fn.ensureBuiltInAuto(true)
		return
	elseif blocker then
		Fn.ensureBuiltInAuto(false)
		return
	end
	Fn.ensureBuiltInAuto(true)

	local hrp = Fn.getHRP()
	local folder = Workspace:FindFirstChild("Breakables")
	if not folder or not hrp then return end

	local cands, seen = {}, {}
	for _, det in ipairs(folder:GetDescendants()) do
		if det:IsA("ClickDetector") then
			-- Detectors can sit on nested parts: climb to the model.
			local m = det.Parent
			while m and not m:IsA("Model") do m = m.Parent end
			if m and m:IsDescendantOf(folder) and (not SKIP_BREAKABLES[m.Name] or State.breakFruits) and not seen[m] then
				seen[m] = true
				-- The alien egg belongs to its own loop, never to normal farming.
				if not (ALIEN_NAMES[m.Name] or m:GetAttribute("MaxHP") ~= nil) then
					local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
					if pp then
						local info = Fn.tierInfo(m)
						local kind = ((info and info.Currency == "Rubies") or m.Name:match("^RTier")) and "ruby" or "normal"
						cands[#cands + 1] = {
							det = det, d = (pp.Position - hrp.Position).Magnitude,
							kind = kind, hp = info and tonumber(info.HP) or 0,
						}
					end
				end
			end
		end
	end

	if #cands == 0 then return end

	-- Best candidate by a comparison; a nil filter means every candidate qualifies.
	local function pickBest(filter, better)
		local best
		for _, c in ipairs(cands) do
			if (not filter or filter(c)) and (not best or better(c, best)) then best = c end
		end
		return best
	end

	local function closer(a, b) return a.d < b.d end
	local function reachable(c) return c.d <= CLICK_RANGE end

	-- Multi-target: hit every chosen breakable within reach in the same tick,
	-- ordered by the target mode so the cap (if reached) keeps the best ones.
	if State.multiClick and typeof(fireclickdetector) == "function" then
		local list = {}
		for _, c in ipairs(cands) do
			if reachable(c) then list[#list + 1] = c end
		end

		if #list > 0 then
			table.sort(list, function(a, b)
				if State.targetMode == "Rubies First" then
					if (a.kind == "ruby") ~= (b.kind == "ruby") then return a.kind == "ruby" end
				elseif State.targetMode == "Highest HP" then
					if a.hp ~= b.hp then return a.hp > b.hp end
				end
				return a.d < b.d
			end)

			for i = 1, math.min(#list, math.clamp(State.maxTargets, 1, 40)) do
				fireclickdetector(list[i].det)
				Stats.clicks = Stats.clicks + 1
			end
			return
		end
		-- Nothing in reach: fall through to the single-target logic below.
	end

	local pick
	if State.targetMode == "Rubies First" then
		pick = pickBest(function(c) return c.kind == "ruby" and reachable(c) end, closer)
	elseif State.targetMode == "Highest HP" then
		pick = pickBest(reachable, function(a, b)
			if a.hp ~= b.hp then return a.hp > b.hp end
			return a.d < b.d
		end)
	end

	-- Nothing matched the mode (or the mode is Nearest): take what is closest.
	if not pick then pick = pickBest(nil, closer) end

	if pick and typeof(fireclickdetector) == "function" then
		fireclickdetector(pick.det)
		Stats.clicks = Stats.clicks + 1
	end
end

Fn.runLoop("AutoClick", function() return State.autoClick end, Fn.clickStep,
	function() return math.clamp(State.clickDelay / 1000, 0.1, 1) end, 0.2)

-----------------------------------------------------------
-- ALIEN EGG
-----------------------------------------------------------

local alienRef = nil

-- What we know about the egg while it may be in a world we are not standing in.
-- Models of other worlds are not loaded here, so the scan cannot see an egg that
-- landed elsewhere: the server's messages say when it is coming and (often) where.
local Alien = {
	pendingUntil = 0,   -- an egg is expected until this time
	eventAt = -math.huge,
	hint = nil,         -- the world the server named, when it named one
	hintSince = nil,    -- when we arrived in that world
	seenWorld = nil,    -- where we last saw the egg
	miss = 0,           -- scans in a row that missed it where it was
	searched = {},      -- worlds already looked in during this search
	pausedUntil = 0,
	log = "",           -- the last server message, for the status line
	state = nil,        -- the last GetState answer
}

-- Search order when the server did not name a world.
local ALIEN_WORLD_ORDER = {
	"Spawn", "BirchForest", "TreasureDunes", "FrozenAlley", "HauntedHouse",
	"PetKingdom", "EnchantedGrove", "VolcanoHollow", "TheMoon",
}

function Fn.alienPending()
	return os.clock() < Alien.pendingUntil
end

-- The egg is alive while it is on screen, or while the server says one is coming.
function Fn.alienGone()
	if not State.destroyAlien then return true end
	return not ((alienRef and alienRef.Parent) or Fn.alienPending())
end

-- Spawned egg may be renamed; the MaxHP attribute plus a ClickDetector is unique to it.
function Fn.scanEgg()
	local found = nil
	for name in pairs(ALIEN_NAMES) do
		local m = Workspace:FindFirstChild(name, true)
		if m and Fn.eggPart(m) then found = m break end
	end

	-- The server's own word on whether an egg event is running (raw call: the Knit
	-- wrapper would shift the arguments).
	local state
	local ok, res = Fn.invoke("AlienEventService", "GetState")
	if ok and type(res[1]) == "string" then state = res[1] end
	if state then alienEventState = state end

	-- A change out of Idle is an event starting. (A state that just stays non-Idle is
	-- not taken as a live egg, or a long cooldown state would hold everything up.)
	if state and state ~= Alien.state then
		if state ~= "Idle" then
			Alien.pendingUntil = math.max(Alien.pendingUntil, os.clock() + 240)
			Alien.log = "state: " .. state
		end
		Alien.state = state
	end

	if not found and ((state ~= nil and state ~= "Idle") or Fn.alienPending()) then
		local breakables = Workspace:FindFirstChild("Breakables")
		if breakables then
			for _, d in ipairs(breakables:GetDescendants()) do
				if d:IsA("ClickDetector") then
					local m = d.Parent
					if m and m:IsA("Model") and not SKIP_BREAKABLES[m.Name] and m:GetAttribute("MaxHP") ~= nil then
						found = m
						break
					end
				end
			end
		end
	end

	alienRef = found

	if found then
		Alien.miss = 0
		Alien.seenWorld = Fn.alienWorld(found) or Alien.seenWorld
		if Alien.seenWorld then Alien.hint = Alien.seenWorld end
		Alien.pendingUntil = math.max(Alien.pendingUntil, os.clock() + 30)
	elseif Alien.seenWorld and Fn.currentWorld() == Fn.normWorld(Alien.seenWorld) then
		-- Standing where it was and it is gone: destroyed, or taken by someone else.
		Alien.miss = Alien.miss + 1
		if Alien.miss >= 2 then
			Alien.pendingUntil, Alien.seenWorld, Alien.hint, Alien.hintSince = 0, nil, nil, nil
			table.clear(Alien.searched)
		end
	end

	local text = "Alien Egg: not spawned"
	if alienRef then
		local hrp = Fn.getHRP()
		local part = Fn.eggPart(alienRef)
		if hrp and part then
			text = string.format("Alien Egg: %d studs away", math.floor((part.Position - hrp.Position).Magnitude))
		else
			text = "Alien Egg: spawned"
		end
		if FeatureStatus.alien then text = text .. " | " .. FeatureStatus.alien end
	elseif Fn.alienPending() then
		text = "Alien Egg: incoming (" .. (Alien.hint and Fn.worldLabel(Alien.hint) or "world unknown") .. ")"
		if FeatureStatus.alien then text = text .. " | " .. FeatureStatus.alien end
	end
	if EggLabel then pcall(function() EggLabel:Set(text) end) end
end

-- Which world the egg landed in: its zone attribute, then the Breakables
-- folder it sits under, then its position inside each world's bounds.
function Fn.alienWorld(egg)
	local zone = egg:GetAttribute("ZoneName")
	if type(zone) == "string" and zone ~= "" then
		return (WORLD_ALIASES[zone] == "HauntedHouse" and "HauntedHouse") or zone
	end

	local breakables = Workspace:FindFirstChild("Breakables")
	local cur = egg
	while cur and cur.Parent and cur.Parent ~= breakables do cur = cur.Parent end
	if cur and cur.Parent == breakables then
		return (cur.Name == "Haunted" and "HauntedHouse") or cur.Name
	end

	local part = Fn.eggPart(egg)
	return part and Fn.worldAtPosition(part.Position) or nil
end

-- The world whose bounds contain a point.
function Fn.worldAtPosition(p)
	local zones = Fn.getModule("WorldZones")
	if zones and type(zones.Bounds) == "table" then
		for name, b in pairs(zones.Bounds) do
			if p.X >= b.minX and p.X <= b.maxX and p.Z >= b.minZ and p.Z <= b.maxZ then return Fn.normWorld(name) end
		end
	end
	return nil
end

-- A world named in some text ("Pet Kingdom", "HauntedHouse"...), as the zone name.
function Fn.knownWorld(text)
	local flat = string.lower((string.gsub(tostring(text), "[^%w]", "")))
	if flat == "" then return nil end
	if flat == "spawn" then return "Spawn" end -- "spawned" is everywhere in event text

	local cost = Fn.getModule("WorldCost")
	local display = cost and cost.DisplayNames
	for _, key in ipairs(ALIEN_WORLD_ORDER) do
		if key ~= "Spawn" then
			local names = { key }
			if type(display) == "table" and type(display[key]) == "string" then names[2] = display[key] end
			for _, name in ipairs(names) do
				local flatName = string.lower((string.gsub(name, "[^%w]", "")))
				if flatName ~= "" and flat:find(flatName, 1, true) then return key end
			end
		end
	end
	if flat:find("haunted", 1, true) then return "HauntedHouse" end
	return nil
end

-- Looks through a message's arguments for a world name or a landing position.
function Fn.findWorldIn(value, depth)
	if depth > 3 then return nil end
	if type(value) == "string" then return Fn.knownWorld(value) end
	if typeof(value) == "Vector3" then return Fn.worldAtPosition(value) end
	if typeof(value) == "CFrame" then return Fn.worldAtPosition(value.Position) end
	if type(value) == "table" then
		for _, v in pairs(value) do
			local world = Fn.findWorldIn(v, depth + 1)
			if world then return world end
		end
	end
	return nil
end

-- Any message from the egg event: an egg is expected, and the message may say where.
function Fn.onAlienEvent(source, ...)
	local args = table.pack(...)
	local parts = {}
	for i = 1, args.n do
		local v = args[i]
		parts[#parts + 1] = type(v) == "table" and Fn.describe(v) or tostring(v)
	end
	Alien.log = string.sub(source .. ": " .. table.concat(parts, ", "), 1, 160)
	Alien.eventAt = os.clock()
	Alien.pendingUntil = math.max(Alien.pendingUntil, os.clock() + 240)

	local world
	for i = 1, args.n do
		world = Fn.findWorldIn(args[i], 0)
		if world then break end
	end
	if world then Alien.hint, Alien.hintSince = world, nil end

	-- A fresh announcement or landing starts the search over.
	if source:find("Announce", 1, true) or source:find("Fall", 1, true) then
		table.clear(Alien.searched)
		Alien.pausedUntil = 0
		task.spawn(pcall, Fn.scanEgg)
	end
end

pcall(function()
	local function listen(remote, source)
		if remote and remote:IsA("RemoteEvent") then
			remote.OnClientEvent:Connect(function(...) Fn.onAlienEvent(source, ...) end)
		end
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local eggsFolder = remotes and remotes:FindFirstChild("Eggs")
	for _, name in ipairs({ "AlienEggAnnounce", "AlienEggFall", "AlienEggUI" }) do
		listen(eggsFolder and eggsFolder:FindFirstChild(name), name)
	end
	for _, name in ipairs({ "Announce", "Fall", "UI" }) do
		listen(Fn.knitRemote("AlienEventService", "RE", name), "AlienEventService." .. name)
	end
end)

local ALIEN_REACH = 95 -- click detectors reach 100 studs
local alienClicks = 0   -- hits on the alien egg, for the end-of-event report

local alienHome = nil          -- where we stood before the event pulled us away
local alienApproached = false  -- the one allowed step-in per event
local alienLastTravel = -math.huge
local alienForcedFarm = false

function Fn.eggHealth(egg)
	local total, found = 0, false
	local function scan(inst)
		for name, v in pairs(inst:GetAttributes()) do
			local lname = name:lower()
			if type(v) == "number" and (lname:find("hp", 1, true) or lname:find("health", 1, true))
				and not lname:find("max", 1, true) then
				total, found = total + v, true
			end
		end
	end
	pcall(function()
		scan(egg)
		for _, d in ipairs(egg:GetDescendants()) do scan(d) end
	end)
	return found and total or nil
end

-- Back to where we were, the same way we left: world teleport, then hop. A new
-- egg appearing on the way cancels the hop; the next tick picks the event up again.
function Fn.returnFromAlien()
	local home = alienHome
	alienHome, alienApproached, alienLastTravel = nil, false, -math.huge
	Fn.returnToPlace(home, function() return not Fn.alienGone() end)
end

-- No egg in view: look for it in the world the server named, or in each world in turn.
function Fn.searchWorlds()
	if os.clock() < Alien.pausedUntil then return end

	for _, world in ipairs(ALIEN_WORLD_ORDER) do
		if Fn.alienGone() or (alienRef and alienRef.Parent) then return end
		if not Alien.searched[world] and Fn.currentWorld() ~= world and Fn.isWorldOwned(world) ~= false then
			Alien.searched[world] = true
			Fn.setFeature("alien", "searching " .. Fn.worldLabel(world) .. " for the egg")

			if Fn.travelToWorld(world, nil, Fn.alienGone) then
				for _ = 1, 6 do -- let the world load in, checking as it does
					task.wait(0.5)
					pcall(Fn.scanEgg)
					if Fn.alienGone() or (alienRef and alienRef.Parent) then return end
				end
			end
		end
	end

	-- Nothing anywhere yet (it may still be falling): start over after a pause.
	table.clear(Alien.searched)
	Alien.pausedUntil = os.clock() + 15
	Fn.setFeature("alien", "egg not found yet, looking again shortly (" .. (Alien.log ~= "" and Alien.log or "no server message") .. ")")
end

function Fn.findAlienEgg()
	local hint = Alien.hint
	if hint then
		local world = Fn.normWorld(hint)
		if Fn.currentWorld() ~= world then
			if os.clock() - alienLastTravel > 10 then
				alienLastTravel = os.clock()
				Alien.hintSince = nil
				Fn.setFeature("alien", "going to " .. Fn.worldLabel(world) .. " for the egg")
				Fn.travelToWorld(world, nil, Fn.alienGone)
				task.wait(1)
				pcall(Fn.scanEgg)
			end
			return
		end

		-- In the named world: give the egg a while to show up before doubting the name.
		Alien.hintSince = Alien.hintSince or os.clock()
		if os.clock() - Alien.hintSince <= 20 then
			Fn.setFeature("alien", "in " .. Fn.worldLabel(world) .. ", waiting for the egg")
			pcall(Fn.scanEgg)
			return
		end
		Alien.hint, Alien.hintSince = nil, nil
	end

	Fn.searchWorlds()
end

-- Highest priority task in the script. While an egg is up (or on its way) everything
-- else holds (see OUTRANKED_BY). It goes to the egg's world with the game's world
-- teleport, and attacks the egg the way breakables are attacked: a click.
function Fn.alienStep()
	if Fn.alienGone() then
		if alienHome then Fn.returnFromAlien() end
		Fn.setClaim("alien", false)
		if alienForcedFarm then
			alienForcedFarm = false
			if not State.autoClick then Fn.ensureBuiltInAuto(false, true) end
		end
		return
	end

	Fn.setClaim("alien", true)

	-- Auto farm stays on for the whole fight; only the clicks move to the egg.
	alienForcedFarm = true
	if not State.craftBusy then Fn.ensureBuiltInAuto(true) end

	-- A crafting trip already under way finishes first; it only lasts a few seconds.
	if State.craftBusy then return end

	if not alienHome then alienHome = Fn.savePlace() end

	local egg = alienRef
	if not (egg and egg.Parent) then
		Fn.findAlienEgg()
		return
	end

	-- One world teleport per attempt window. If the zone never confirms (it can
	-- lag), carry on and click rather than re-teleporting every tick.
	local world = Fn.alienWorld(egg)
	if world and Fn.currentWorld() ~= Fn.normWorld(world) and os.clock() - alienLastTravel > 10 then
		alienLastTravel = os.clock()
		Fn.travelToWorld(world)
		return -- re-check next tick: the egg may have moved or despawned meanwhile
	end

	local det = egg:IsA("Model") and egg:FindFirstChildWhichIsA("ClickDetector", true) or nil
	local part = Fn.eggPart(egg)
	if not part then Fn.setFeature("alien", "egg has no part to aim at") return end

	-- Normally the world teleport lands within click range. If the egg is still
	-- out of reach, hop in once - to the edge of range, not onto the egg.
	local hrp = Fn.getHRP()
	if hrp and not alienApproached and (part.Position - hrp.Position).Magnitude > ALIEN_REACH then
		alienApproached = true
		local away = hrp.Position - part.Position
		away = Vector3.new(away.X, 0, away.Z)
		away = away.Magnitude > 1 and away.Unit or Vector3.new(1, 0, 0)
		Fn.teleportTo(Fn.groundAt(part.Position + away * 60), 8, 20, Fn.alienGone)
	end

	if not det then Fn.setFeature("alien", "egg has no click detector") return end

	-- The same click the breakables get.
	if typeof(fireclickdetector) == "function" then fireclickdetector(det) end
	Stats.clicks = Stats.clicks + 1
	alienClicks = alienClicks + 1

	local hp = Fn.eggHealth(egg)
	Fn.setFeature("alien", hp and string.format("attacking the egg (health %d)", math.floor(hp)) or "attacking the egg")
end

task.spawn(function()
	while Fn.alive() do
		pcall(Fn.scanEgg)
		task.wait((State.destroyAlien and 2) or 6)
	end
end)

-- Always running so the claim is released (and we are sent home) the moment the
-- toggle goes off or the egg is gone.
Fn.runLoop("AlienEgg", function() return true end, Fn.alienStep,
	function() return alienRef and math.clamp(State.clickDelay / 1000, 0.1, 1) or 1 end, 0.15)

