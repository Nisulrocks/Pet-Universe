warn("[PU DEBUG] Before Rayfield")

local ok, result = false, nil

-- sirius.menu is tried first, then the same library from GitHub in case that host is blocked.
do
    local urls = {
        "https://sirius.menu/rayfield",
        "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua",
    }
    local errors = {}
    for _, url in ipairs(urls) do
        local good, value = pcall(function()
            local chunk, compileError = loadstring(game:HttpGet(url))
            if not chunk then error("loadstring: " .. tostring(compileError)) end
            return chunk()
        end)
        if good and value then
            ok, result = true, value
            break
        end
        errors[#errors + 1] = url .. " -> " .. tostring(value)
    end
    if not ok then
        warn("[PU] Rayfield failed to load: " .. table.concat(errors, " | "))
    end
end

warn("[PU DEBUG] Rayfield result:", ok, result)

if not ok or not result then
    return
end

Rayfield = result

warn("[PU DEBUG] After Rayfield")
env.NisulPURayfield = Rayfield

local windowOk, Window = pcall(Rayfield.CreateWindow, Rayfield, {
	Name = "Pets Universe V1.0.3",
	LoadingTitle = "PU Auto Farm V1.0.3",
	LoadingSubtitle = "by NisulRocks | Made with love",
	ShowText = "PU Auto Farm",
	Theme = "Default",
	ToggleUIKeybind = "K",
	Discord = { Enabled = true, Invite = "jUctfTAa5D", RememberJoins = true },
	ConfigurationSaving = { Enabled = true, FolderName = "NisulRocks PU", FileName = "PU_AutoFarm_V1" },
	KeySystem = false,
})

if not windowOk or not Window then
	warn("[PU] Rayfield could not build the window (this executor may not support it): " .. tostring(Window))
	return
end

-- Small builders so each tab reads as a list of options, not boilerplate.
function Fn.addToggle(tab, label, name, flag, default, onChange, tooltip)
	return Fn.safeUI(label, function()
		return tab:CreateToggle({
			Name = name, CurrentValue = default, Flag = flag,
			Callback = function(v) onChange(v) end,
		})
	end)
end

function Fn.addSlider(tab, label, name, flag, range, increment, suffix, default, onChange)
	return Fn.safeUI(label, function()
		local element = tab:CreateSlider({
			Name = name, Range = range, Increment = increment, Suffix = suffix,
			CurrentValue = default, Flag = flag,
			Callback = function(v) onChange(v) end,
		})

		-- Rayfield applies the saved config through element:Set. A value of the wrong
		-- kind (a flag an older version used for another control) would error there.
		if type(element) == "table" and type(element.Set) == "function" then
			local set = element.Set
			element.Set = function(self, value, ...)
				value = tonumber(type(value) == "table" and value[1] or value)
				if not value then return end
				return set(self, value, ...)
			end
		end
		return element
	end)
end

function Fn.addDropdown(tab, label, name, flag, options, default, multi, onChange)
	return Fn.safeUI(label, function()
		local element = tab:CreateDropdown({
			Name = name, Options = options, CurrentOption = default,
			MultipleOptions = multi, Flag = flag,
			Callback = function(selected) onChange(selected) end,
		})

		-- Same guard as the slider: a saved number for a dropdown would make
		-- Rayfield's Set index it and error. Turn it into the matching option text.
		if type(element) == "table" and type(element.Set) == "function" then
			local set = element.Set
			element.Set = function(self, value, ...)
				if type(value) ~= "table" and type(value) ~= "string" then value = { tostring(value) } end
				return set(self, value, ...)
			end
		end
		return element
	end)
end

function Fn.addButton(tab, label, name, onClick)
	return Fn.safeUI(label, function()
		return tab:CreateButton({
			Name = name,
			Callback = function() task.spawn(onClick) end,
		})
	end)
end

