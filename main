Fn.runLoop("Upgrades", function()
	for _, on in pairs(State.upgrades) do if on then return true end end
	return false
end, function()
	for name, on in pairs(State.upgrades) do
		if on and Fn.alive() then
			if Fn.fire("UpgradesService", "BuyUpgrade", name) then Stats.upgrades = Stats.upgrades + 1 end
			task.wait(Fn.jitter(0.4))
		end
	end
end, function() return 1.5 end, 0.2)

Fn.runLoop("BuyWorlds", function() return State.autoBuyWorlds end, function()
	Fn.fire("TeleportService", "Purchase", "Bought")
	Fn.fire("TeleportService", "Purchase", "BoughtMoon")
end, function() return 1.5 end, 0.2)

-- "Best" world = the furthest coin world you own, in the game's own unlock order.
-- The Moon is left out: it runs on its own currency and unlock path, so it is
-- never an automatic farming destination.
local WORLD_PROGRESSION = { "BirchForest", "TreasureDunes", "FrozenAlley", "HauntedHouse", "PetKingdom", "EnchantedGrove", "VolcanoHollow" }

function Fn.worldProgression()
	local cfg = Fn.getModule("WorldCost")
	if cfg and type(cfg.Order) == "table" and #cfg.Order > 0 then return cfg.Order end
	return WORLD_PROGRESSION
end

-- Returns nil (not false) when ownership data is not available yet, so the
-- caller never mistakes "data missing" for "nothing unlocked" and sends us to Spawn.
function Fn.getBestWorld()
	if not Fn.dataFolder("WorldsData") then return nil end

	local best = "Spawn"
	for _, name in ipairs(Fn.worldProgression()) do
		if Fn.isWorldOwned(name) then best = name end
	end
	return best
end

local lastBestTeleport = 0

-- Lowest priority: yields to the alien egg, crafting trips, index farming and
-- hatching (where the egg keeper owns our position).
Fn.runLoop("TpBestWorld", function() return State.autoTpBestWorld end, function()
	if Fn.held("bestworld") then return end

	local best = Fn.getBestWorld()
	if not best or Fn.currentWorld() == best then return end

	-- Loading into a world takes a moment; do not re-fire while it is in flight.
	if os.clock() - lastBestTeleport < 10 then return end
	lastBestTeleport = os.clock()

	Fn.setStatus("teleporting to best world: " .. best)
	Fn.travelToWorld(best)
end, function() return 2 end, 0.2)

