--[[
    Pets Universe - temporarily disabled notice

    Host this file in place of the Pets Universe script while it is switched off. It only
    shows the notice (same hologram look as the NisulRocks Script Hub) and starts nothing.
    To bring the script back, host the real "Pets Universe.lua" again.
]]

local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer

local DISCORD_INVITE = "jUctfTAa5D"

local MESSAGE = "Greetings Script user, It has come to my attention that Pet Universe is currently going through a ban wave, in order to protect you from getting banned, i have chosen to disable This script."
local SIGN_OFF = "- <font color='#ff3333'>Nisulrocks Scripts</font>"

-- Red Protocol V8 Color Palette (same as the Script Hub)
local Colors = {
    Background = Color3.fromRGB(10, 10, 12),
    NeonRed = Color3.fromRGB(255, 30, 30),
    NeonGreen = Color3.fromRGB(0, 255, 120),
    NeonBlue = Color3.fromRGB(100, 100, 255),
    Text = Color3.fromRGB(240, 240, 240),
    Gray = Color3.fromRGB(60, 60, 60),
}

-- A second run replaces the first instead of stacking notices.
local env = (getgenv and getgenv()) or _G
if env.NisulPUDisabledNotice then
    pcall(function() env.NisulPUDisabledNotice:Destroy() end)
    env.NisulPUDisabledNotice = nil
end

print("========================================")
print("  NisulRocks Script Hub - Pets Universe")
print("  Temporarily disabled")
print("========================================")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ScriptHubHologram"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Safe Parent
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then
    ScreenGui.Parent = Player:WaitForChild("PlayerGui")
end
env.NisulPUDisabledNotice = ScreenGui

-- Determine target size based on screen
local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
local targetWidth = math.clamp(viewportSize.X * 0.5, 300, 450)
local textWidth = targetWidth - 40

-- The message wraps, so the canvas is as tall as the text needs.
local messageHeight = 60
pcall(function()
    messageHeight = TextService:GetTextSize(MESSAGE, 14, Enum.Font.Code, Vector2.new(textWidth, 10000)).Y + 4
end)

local titleY, messageY = 12, 48
local footerY = messageY + messageHeight + 10
local buttonY = footerY + 26
local targetHeight = buttonY + 28 + 16

-- Main Canvas (starts collapsed for animation)
local MainCanvas = Instance.new("Frame")
MainCanvas.Name = "MainCanvas"
MainCanvas.Size = UDim2.new(0, 0, 0, 2)
MainCanvas.Position = UDim2.new(0.5, 0, 0.5, 0)
MainCanvas.AnchorPoint = Vector2.new(0.5, 0.5)
MainCanvas.BackgroundColor3 = Colors.Background
MainCanvas.BackgroundTransparency = 0.1
MainCanvas.BorderSizePixel = 0
MainCanvas.ClipsDescendants = true
MainCanvas.Parent = ScreenGui

-- Neon Glow Stroke
local UIStroke = Instance.new("UIStroke")
UIStroke.Parent = MainCanvas
UIStroke.Color = Colors.NeonRed
UIStroke.Thickness = 2
UIStroke.Transparency = 0

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainCanvas

-- Content Frame
local ContentFrame = Instance.new("Frame")
ContentFrame.Size = UDim2.new(1, 0, 1, 0)
ContentFrame.BackgroundTransparency = 1
ContentFrame.Parent = MainCanvas

-- Title Label
local TitleLabel = Instance.new("TextLabel")
TitleLabel.Name = "Title"
TitleLabel.Size = UDim2.new(1, -80, 0, 30)
TitleLabel.Position = UDim2.new(0, 20, 0, titleY)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "Script <font color='#ff3333'>Temporarily Disabled</font>"
TitleLabel.RichText = true
TitleLabel.TextColor3 = Colors.Text
TitleLabel.Font = Enum.Font.GothamBlack
TitleLabel.TextSize = 18
TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
TitleLabel.TextTransparency = 1
TitleLabel.Parent = ContentFrame

-- Message
local MessageLabel = Instance.new("TextLabel")
MessageLabel.Name = "Message"
MessageLabel.Size = UDim2.new(1, -40, 0, messageHeight)
MessageLabel.Position = UDim2.new(0, 20, 0, messageY)
MessageLabel.BackgroundTransparency = 1
MessageLabel.Text = MESSAGE
MessageLabel.TextColor3 = Colors.Text
MessageLabel.Font = Enum.Font.Code
MessageLabel.TextSize = 14
MessageLabel.TextWrapped = true
MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
MessageLabel.TextYAlignment = Enum.TextYAlignment.Top
MessageLabel.TextTransparency = 1
MessageLabel.Parent = ContentFrame

-- Sign off
local FooterLabel = Instance.new("TextLabel")
FooterLabel.Name = "Footer"
FooterLabel.Size = UDim2.new(1, -40, 0, 20)
FooterLabel.Position = UDim2.new(0, 20, 0, footerY)
FooterLabel.BackgroundTransparency = 1
FooterLabel.Text = SIGN_OFF
FooterLabel.RichText = true
FooterLabel.TextColor3 = Colors.Text
FooterLabel.Font = Enum.Font.GothamBold
FooterLabel.TextSize = 14
FooterLabel.TextXAlignment = Enum.TextXAlignment.Left
FooterLabel.TextTransparency = 1
FooterLabel.Parent = ContentFrame

-- Close (top right)
local CloseButton = Instance.new("TextButton")
CloseButton.Name = "Close"
CloseButton.Size = UDim2.new(0, 28, 0, 28)
CloseButton.Position = UDim2.new(1, -38, 0, 11)
CloseButton.BackgroundTransparency = 1
CloseButton.Text = "X"
CloseButton.TextColor3 = Colors.Text
CloseButton.Font = Enum.Font.GothamBold
CloseButton.TextSize = 14
CloseButton.TextTransparency = 1
CloseButton.AutoButtonColor = false
CloseButton.Parent = ContentFrame

-- Join Discord button
local DiscordButton = Instance.new("TextButton")
DiscordButton.Name = "Discord"
DiscordButton.Size = UDim2.new(0, 190, 0, 28)
DiscordButton.Position = UDim2.new(0, 20, 0, buttonY)
DiscordButton.BackgroundColor3 = Colors.Background
DiscordButton.BackgroundTransparency = 1
DiscordButton.Text = "Join Discord for Updates"
DiscordButton.TextColor3 = Colors.Text
DiscordButton.Font = Enum.Font.GothamBold
DiscordButton.TextSize = 13
DiscordButton.TextTransparency = 1
DiscordButton.AutoButtonColor = false
DiscordButton.Parent = ContentFrame

local ButtonStroke = Instance.new("UIStroke")
ButtonStroke.Color = Colors.NeonBlue
ButtonStroke.Thickness = 1.5
ButtonStroke.Transparency = 1
ButtonStroke.Parent = DiscordButton

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 4)
ButtonCorner.Parent = DiscordButton

DiscordButton.MouseEnter:Connect(function()
    TweenService:Create(ButtonStroke, TweenInfo.new(0.2), { Color = Colors.NeonGreen }):Play()
end)
DiscordButton.MouseLeave:Connect(function()
    TweenService:Create(ButtonStroke, TweenInfo.new(0.2), { Color = Colors.NeonBlue }):Play()
end)

-- Opens the invite in the Discord app when the executor can reach it, and always copies it.
DiscordButton.MouseButton1Click:Connect(function()
    local link = "https://discord.gg/" .. DISCORD_INVITE
    local requestFn = (syn and syn.request) or (http and http.request) or http_request or request
    if requestFn then
        pcall(requestFn, {
            Url = "http://127.0.0.1:6463/rpc?v=1",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Origin"] = "https://discord.com" },
            Body = HttpService:JSONEncode({
                cmd = "INVITE_BROWSER",
                args = { code = DISCORD_INVITE },
                nonce = HttpService:GenerateGUID(false),
            }),
        })
    end
    local copied = false
    if typeof(setclipboard) == "function" then copied = pcall(setclipboard, link) end

    DiscordButton.Text = copied and "Invite copied!" or link
    TweenService:Create(ButtonStroke, TweenInfo.new(0.2), { Color = Colors.NeonGreen }):Play()
    task.delay(2, function()
        if DiscordButton.Parent then DiscordButton.Text = "Join Discord for Updates" end
    end)
end)

-- Collapse height then width, then remove (same close as the hub)
local closing = false
local function Close()
    if closing then return end
    closing = true
    for _, v in pairs(ContentFrame:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            TweenService:Create(v, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
        end
    end
    TweenService:Create(ButtonStroke, TweenInfo.new(0.2), { Transparency = 1 }):Play()
    task.wait(0.2)
    TweenService:Create(MainCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, targetWidth, 0, 2),
    }):Play()
    task.wait(0.4)
    TweenService:Create(MainCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
    }):Play()
    task.wait(0.3)
    ScreenGui:Destroy()
    env.NisulPUDisabledNotice = nil
end
CloseButton.MouseButton1Click:Connect(Close)

-- Animation: Expand width first
TweenService:Create(MainCanvas, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, targetWidth, 0, 2),
}):Play()
task.wait(0.5)

-- Animation: Expand height
TweenService:Create(MainCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, targetWidth, 0, targetHeight),
}):Play()
task.wait(0.3)

-- Fade in text
TweenService:Create(TitleLabel, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
TweenService:Create(CloseButton, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
task.wait(0.1)
TweenService:Create(MessageLabel, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
task.wait(0.1)
TweenService:Create(FooterLabel, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
task.wait(0.1)
TweenService:Create(DiscordButton, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
TweenService:Create(ButtonStroke, TweenInfo.new(0.4), { Transparency = 0 }):Play()
