	State.fishWorld = Fn.fishWorldKey(Fn.firstOption(s))
end)

Fn.addSlider(FishingTab, "Fishing/Interval", "Tap Interval", "FishTapInterval", { 0.4, 2 }, 0.05, "s", State.fishTapInterval, function(v)
	State.fishTapInterval = v -- the server allows a tap every 0.2s; the game's own pace is about 0.7s
end)

Fn.addButton(FishingTab, "Fishing/Here", "Fish Here (start where I stand)", Fn.fishHere)
Fn.addButton(FishingTab, "Fishing/Stop", "Stop Fishing Now", function() Fn.stopFishing("stopped by you") end)
Fn.addButton(FishingTab, "Fishing/CopyPos", "Copy My Position", function()
	local hrp = Fn.getHRP()
	if not hrp then return end
	local p = hrp.Position
	local text = string.format("Vector3.new(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)
	if typeof(setclipboard) == "function" then pcall(setclipboard, text) end
	Fn.setFeature("fishing", "position copied: " .. text)
end)

Fn.safeUI("Fishing/BoostSection", function() FishingTab:CreateSection("Boosts") end)

Fn.addToggle(FishingTab, "Fishing/Boosts", "Auto Use Worms & Hooks (while fishing)", "AutoFishBoosts", false, function(v) State.autoFishBoosts = v end)

do
	local labels, idOf = {}, {}
	for _, entry in ipairs(FISH_BOOST_LABELS) do
		labels[#labels + 1] = entry[1]
		idOf[entry[1]] = entry[2]
	end

	Fn.addDropdown(FishingTab, "Fishing/BoostItems", "Worms & Hooks To Use", "BoostItems", labels, {}, true, function(s)
		local ids = {}
		for label in pairs(Fn.toSet(s)) do
			if idOf[label] then ids[idOf[label]] = true end
		end
		State.boostItems = ids
	end)
end

Fn.safeUI("Fishing/MerchantSection", function() FishingTab:CreateSection("Merchant (Treasure Dunes)") end)

Fn.addToggle(FishingTab, "Fishing/Sell", "Auto Sell Fish For Tokens", "AutoSellFish", false, function(v) State.autoSellFish = v end)
Fn.addToggle(FishingTab, "Fishing/KeepOne", "Keep 1 Of Each Fish", "SellKeepOne", false, function(v) State.sellKeepOne = v end)
Fn.addSlider(FishingTab, "Fishing/SellInterval", "Sell Interval", "SellInterval", { 1, 120 }, 1, " min", State.sellInterval, function(v) State.sellInterval = v end)

-- Fish names come from the merchant's own price list, so new fish appear on their own.
local SELL_NAMES = {}
do
	local cfg = Fn.getModule("Merchant")
	local unsellable = cfg and type(cfg.UNSELLABLE) == "table" and cfg.UNSELLABLE or {}
	for name in pairs(cfg and cfg.SellPrices or {}) do
		if not unsellable[name] then SELL_NAMES[#SELL_NAMES + 1] = name end
	end
	table.sort(SELL_NAMES)
end

Fn.addDropdown(FishingTab, "Fishing/SellNames", "Fish To Sell", "SellNames", SELL_NAMES, {}, true, function(s)
	State.sellNames = Fn.toSet(s)
end)
Fn.addToggle(FishingTab, "Fishing/SellVariants", "Also Sell Golden & Diamond Fish", "SellVariants", true, function(v) State.sellVariants = v end)

-- Offer ids come straight from the merchant's own pool, so new offers appear on their own.
local MERCHANT_IDS = {}
do
	local cfg = Fn.getModule("Merchant")
	local seen = {}
	for _, entry in ipairs(cfg and cfg.Pool or {}) do
		if type(entry.Id) == "string" and not seen[entry.Id] then
			seen[entry.Id] = true
			MERCHANT_IDS[#MERCHANT_IDS + 1] = entry.Id
		end
	end
	table.sort(MERCHANT_IDS)
end

Fn.addToggle(FishingTab, "Fishing/Buy", "Auto Buy Merchant Offers", "AutoMerchantBuy", false, function(v) State.autoMerchantBuy = v end)
Fn.addDropdown(FishingTab, "Fishing/Wants", "Offers To Buy (none = fishing boosters)", "MerchantWants", MERCHANT_IDS, {}, true, function(s)
	State.merchantWants = Fn.toSet(s)
end)

Fn.safeUI("Fishing/TreeSection", function() FishingTab:CreateSection("Fishing Upgrade Tree") end)

Fn.addToggle(FishingTab, "Fishing/Tree", "Auto Buy Fishing Upgrades", "AutoFishTree", false, function(v) State.autoFishTree = v end)
Fn.addDropdown(FishingTab, "Fishing/TreePriority", "Upgrade Priority", "FishTreePriority", TREE_PRIORITIES, { "Cheapest First" }, false, function(s)
	local choice = Fn.firstOption(s)
	State.fishTreePriority = table.find(TREE_PRIORITIES, choice) and choice or "Cheapest First"
end)

Fn.addButton(FishingTab, "Fishing/RunMerchant", "Run Merchant Trip Now", function() Fn.merchantTrip(true) end)

FishingParagraph = Fn.safeUI("Fishing/Status", function()
	return FishingTab:CreateParagraph({ Title = "Fishing Status", Content = "Off" })
end)

