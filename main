			pcall(function() LocalPlayer:SetAttribute("EggHatchUIHidden", nil) end)
		end
		if typeof(getconnections) ~= "function" then
			Fn.notify("Hatch Animation", "getconnections unavailable - only clearing leftover visuals", 6)
		end
