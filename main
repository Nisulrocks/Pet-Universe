		Name = "Reset Session Stats",
		Callback = function()
			for _, key in ipairs({ "clicks", "hatches", "claims", "crafts", "upgrades", "errors" }) do
				Stats[key] = 0
			end
			Stats.startTime = os.time()
			Fn.notify("Stats", "Counters reset")
		end,
	})
end)

