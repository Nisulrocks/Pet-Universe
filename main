local UIErrors = {}

function Fn.setStatus(text)
	if StatusParagraph then
		pcall(function()
			StatusParagraph:Set({ Title = "Status", Content = tostring(text) })
		end)
	end
end

function Fn.notify(title, content, dur)
	pcall(function()
		Rayfield:Notify({ Title = title, Content = content, Duration = dur or 4, Image = ICON_ID })
	end)
end

function Fn.logError(where, err)
	Stats.errors = Stats.errors + 1
	warn(string.format("[PU] %s failed: %s", where, tostring(err)))
end

-- Rayfield throwing on one malformed element aborts every statement after it.
-- Isolate each element so one bad option cannot take a whole tab down.
function Fn.safeUI(label, builder)
	local ok, result = pcall(builder)
	if not ok then
		UIErrors[#UIErrors + 1] = string.format("%s -> %s", label, tostring(result))
		warn(string.format("[PU] UI element %q failed: %s", label, tostring(result)))
		return nil
	end
	return result
end

-- Rayfield hands multi-select dropdowns back as an array; flip it into a set.
function Fn.toSet(selected)
	local set = {}
	if type(selected) == "table" then
		for _, name in ipairs(selected) do set[name] = true end
	elseif type(selected) == "string" then
		set[selected] = true
	end
	return set
end

function Fn.firstOption(option)
	return type(option) == "table" and option[1] or option
end

-----------------------------------------------------------
-- TIMING
-----------------------------------------------------------

-- Metronome-perfect remotes are easy to flag, so every wait is humanised.
function Fn.jitter(base, frac)
	frac = frac or 0.2
	return base * (1 - frac + math.random() * frac * 2)
end

function Fn.phase(maxWait)
	task.wait(math.random() * (maxWait or 1))
end

-- One long-lived loop per feature. Idles cheaply while the feature is off, so
-- toggling never spawns duplicate threads and config autoload just works.
function Fn.runLoop(label, enabled, step, interval, frac)
	task.spawn(function()
		Fn.phase(1.5)
		while Fn.alive() do
			if enabled() then
				local ok, err = pcall(step)
				if not ok then Fn.logError(label, err) end
				task.wait(Fn.jitter(interval(), frac))
			else
				task.wait(0.5)
			end
		end
	end)
end

