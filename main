-- Shop keys come from the moon modules' Order arrays.
local MOON_INC_LIST  = { "Damage", "MoreGems", "TapPower", "PetAttackSpeed", "CritDmg", "ChestTier", "Blackhole", "AstralBeeChance", "AstralBeeVariant" }
local MOON_PERM_LIST = { "CoinMultiplier", "RubiesMultiplier", "GemsMultiplier", "LuckMultiplier", "HatchSpeedMultiplier", "CritChance", "EggHatch", "PetEquip" }

function Fn.buyMoonShop(serviceName, keys)
	for _, key in ipairs(keys) do
		if not Fn.alive() then return end
		if Fn.fire(serviceName, "BuyUpgrade", key) then Stats.upgrades = Stats.upgrades + 1 end
		task.wait(0.25)
	end
end

Fn.runLoop("MoonInc",  function() return State.autoMoonInc  end, function() Fn.buyMoonShop("MoonUpgradesService",     MOON_INC_LIST)  end, function() return 2.5 end, 0.2)
Fn.runLoop("MoonPerm", function() return State.autoMoonPerm end, function() Fn.buyMoonShop("MoonPermUpgradesService", MOON_PERM_LIST) end, function() return 2.5 end, 0.2)

-- Buy affordable nodes in tree order (parents first), max 5 per pass.
function Fn.buyTreePass()
	local data = Fn.getModule("TreeData")
	if type(data) ~= "table" then return end

	local nums = {}
	for k in pairs(data) do
		if type(k) == "number" then nums[#nums + 1] = k end
	end
	table.sort(nums)

	local stats = Fn.dataFolder("Stats")
	local rubies = stats and stats:FindFirstChild("Rubies")
	local balance = (rubies and rubies.Value) or 0
	local tree = Fn.dataFolder("TreeData")

	local function owned(id)
		local v = tree and tree:FindFirstChild(id)
		return v and v.Value
	end

	local bought = 0
	for _, k in ipairs(nums) do
		if bought >= 5 then break end
		local e = data[k]
		if type(e) == "table" and type(e.id) == "string" and e.id ~= "start" and not owned(e.id) then
			local parentOk = not e.parent or owned(e.parent)
			local cost = tonumber(e.cost) or 0
			if parentOk and cost <= balance then
				if Fn.fire("UpgradeTreeService", "BuyNode", e.id) then
					bought = bought + 1
					Stats.upgrades = Stats.upgrades + 1
					balance = balance - cost
				end
			end
		end
	end
end

Fn.runLoop("SkillTree", function() return State.autoSkillTree end, Fn.buyTreePass, function() return 3 end, 0.3)

-- Lucky blocks: Open(name, amount), 8 max per call.
local LUCKYBLOCK_LIST = { "BasicLuckyblock", "RareLuckyblock", "HackerLuckyblock" }

function Fn.openBlocksOnce()
	local misc = Fn.dataFolder("MiscData")
	local v = misc and misc:FindFirstChild(State.luckyBlock)
	local owned = (v and v.Value) or 0
	if owned > 0 then
		Fn.fire("LuckyBlockService", "Open", State.luckyBlock, math.min(owned, State.blockAmount, 8))
	end
end

Fn.runLoop("LuckyBlocks", function() return State.autoOpenBlocks end, Fn.openBlocksOnce, function() return 5 end, 0.3)

-- Moon rebirth resets incremental upgrades, so only fire once the game flags it ready.
function Fn.doMoonRebirth()
	local cfg = Fn.getModule("MoonConfig")
	if not (cfg and cfg.GetRebirthProgress) then return end
	local _, _, _, ready = cfg.GetRebirthProgress(LocalPlayer)
	if not ready then return end
	if cfg.HasRebirthsLeft and not cfg.HasRebirthsLeft(LocalPlayer) then return end
	Fn.fire("MoonRebirthService", "DoRebirth")
end

Fn.runLoop("MoonRebirth", function() return State.autoMoonRebirth end, Fn.doMoonRebirth, function() return 5 end, 0.3)

