local ITEM_LIST = {
	"Apple", "Banana", "Blueberry", "Kiwi", "Mango", "Taco",
	"CoinsPotion", "CoinsPotion2", "CoinsPotion3", "RubiesPotion", "RubiesPotion2", "RubiesPotion3",
	"LuckPotion", "LuckPotion2", "LuckPotion3", "HatchSpeedPotion", "HatchSpeedPotion2", "HatchSpeedPotion3",
	"CriticalPotion", "CriticalPotion2", "CriticalPotion3",
	"Ball", "Bone", "Cookie", "Squeaky", "Canned Tuna",
	"Worm", "Worm1", "Worm2", "UniverseWorm", "Fishhook", "Golden Fishhook", "MasteryPotion",
}

function Fn.ownedCount(name)
	for _, folderName in ipairs({ "FruitsData", "PotionsData", "ToysData", "MiscData", "FishingItemsData" }) do
		local f = Fn.dataFolder(folderName)
		local v = f and f:FindFirstChild(name)
		if v and typeof(v.Value) == "number" then return v.Value end
	end
	return 1 -- unknown folder: let the server validate
end

local ITEM_MODES    = { "Every Interval", "When Previous Expires" }
-- The amounts the game's own multi-use picker offers (MultiUseModule.Allowed).
local USE_AMOUNTS   = { "1", "5", "10", "25" }

-- Seconds left on an active potion/fruit, read from the boost HUD the game
-- draws ("MM:SS" or "H:MM:SS", "00:00" when idle). Nil if the item is not shown there.
function Fn.hudTimeLeft(name)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local ui = pg and pg:FindFirstChild("BoostUI")
	local holder = ui and ui:FindFirstChild("LeftHolder")
	local frame = holder and holder:FindFirstChild(name)
	local label = frame and frame:FindFirstChild("Countdown")
	if not (label and label:IsA("TextLabel")) then return nil end

	local h, m, s = label.Text:match("^(%d+):(%d+):(%d+)$")
	if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end
	m, s = label.Text:match("^(%d+):(%d+)$")
	if m then return tonumber(m) * 60 + tonumber(s) end
	return nil
end

-- Backup source: the mirrored timer values. Treated as an expiry timestamp
-- when huge, otherwise as seconds remaining.
function Fn.mirrorTimeLeft(name)
	for _, folderName in ipairs({ "PotionsTimeData", "FruitsTimeData" }) do
		local f = Fn.dataFolder(folderName)
		local v = f and f:FindFirstChild(name)
		if v and typeof(v.Value) == "number" then
			if v.Value > 1e9 then return math.max(0, v.Value - os.time()) end
			return v.Value
		end
	end
	return nil
end

function Fn.itemTimeLeft(name)
	return Fn.hudTimeLeft(name) or Fn.mirrorTimeLeft(name)
end

local lastUsed = {}

-- "Every Interval" fires each selected item every pass. "When Previous Expires"
-- only fires an item once its timer has run out (so a potion never stacks or
-- wastes time), and falls back to the interval for items that have no timer.
-- force = true (the Use Now button) ignores the mode.
function Fn.useSelectedItems(force)
	local names = {}
	for name in pairs(State.selectedItems) do names[#names + 1] = name end
	table.sort(names)
	if #names == 0 then return end

	for _, name in ipairs(names) do
		if not Fn.alive() then return end

		local now = os.clock()
		local since = now - (lastUsed[name] or -math.huge)
		local due = true

		if not force and State.itemMode == "When Previous Expires" then
			local left = Fn.itemTimeLeft(name)
			if left ~= nil then
				-- The 3s guard covers the gap before the HUD reflects a fresh use.
				due = left <= 0 and since > 3
			else
				due = since >= State.useInterval
			end
		end

		if due and Fn.ownedCount(name) > 0 then
			Fn.fire("ConsumablesService", "UseItem", name, math.clamp(State.useAmount, 1, 25))
			lastUsed[name] = os.clock()
			task.wait(0.7) -- the server takes ~1 item per window; same-tick fires get dropped
		end
	end
end

-- Expiry mode has to poll quickly to catch the moment a timer hits zero.
Fn.runLoop("UseItems", function() return State.autoUseItems end, function() Fn.useSelectedItems(false) end,
	function()
		if State.itemMode == "When Previous Expires" then return 1 end
		return math.clamp(State.useInterval, 1, 300)
	end, 0.05)

-- Crafting recipes are read live so new game updates show up automatically.
local CRAFT_IDS = {}
pcall(function()
	local cfg = Fn.getModule("ItemCraft")
	for _, r in ipairs(cfg and cfg.Recipes or {}) do
		if type(r.Id) == "string" then CRAFT_IDS[#CRAFT_IDS + 1] = r.Id end
	end
	table.sort(CRAFT_IDS)
end)
if #CRAFT_IDS == 0 then
	CRAFT_IDS = { "Potion_Coins", "Potion_Rubies", "Potion_Luck", "Potion_Critical", "Potion_Hatch" }
end

-- Only fires affordable recipes (MaxCraftable), capped per request like the game's own button.
function Fn.craftStationOnce()
	local cfg = Fn.getModule("ItemCraft")
	if not cfg then return end

	local ids = {}
	for id in pairs(State.craftRecipes) do ids[#ids + 1] = id end
	table.sort(ids)
	if #ids == 0 then return end

	local svc = Fn.GetSvc("ItemCraftService", { "DoCraft", "Craft" })
	if not svc or not svc.Craft then return end

	local cap = cfg.MAX_CRAFT_PER_REQUEST or 100
	for _, id in ipairs(ids) do
		local ok, n = pcall(cfg.MaxCraftable, LocalPlayer, id)
		if ok and type(n) == "number" and n > 0 then
			local sent, err = pcall(svc.Craft, id, math.min(n, cap))
			if sent then Stats.crafts = Stats.crafts + 1 else Fn.logError("ItemCraft", err) end
			task.wait(0.3)
		end
	end
end

Fn.runLoop("AutoCraft", function() return State.autoCraft end, Fn.craftStationOnce, function() return 5 end, 0.3)

-----------------------------------------------------------
-- FISHING ECONOMY (sell, buy, upgrade tree, boosts)
-----------------------------------------------------------

-- Fishing earns Tokens: some drop while fishing, the rest come from selling
-- fish pets to the merchant (TreasureDunes). Tokens buy rotating merchant
-- offers and the fishing upgrade tree. The merchant's call formats are not
-- published, so they go through tryForms and are confirmed by the token and
-- pet counts the game itself keeps.

local MERCHANT_WORLD = "TreasureDunes"

function Fn.fishTokens()
	local v = Fn.dataValue("FishingMerchantData", "Tokens")
	return type(v) == "number" and v or nil
end

-- Boosts ---------------------------------------------------------------------

-- Worms add luck for a while; of the four, only one needs to be active, so the
-- best owned one is used. Hooks last for a number of catches (a "charges"
-- counter), and again only one needs to be live.
local WORM_ORDER = { "UniverseWorm", "Worm2", "Worm1", "Worm" }

-- What the player sees in the dropdown -> the item id the game uses. Names are the
-- game's own (Worm1 is the Juicy Worm, Worm2 the Golden Worm).
local FISH_BOOST_LABELS = {
	{ "Worm",            "Worm" },
	{ "Juicy Worm",      "Worm1" },
	{ "Golden Worm",     "Worm2" },
	{ "Universe Worm",   "UniverseWorm" },
	{ "Fishhook",        "Fishhook" },
	{ "Golden Fishhook", "Golden Fishhook" },
}
local HOOKS = {
	{ item = "Golden Fishhook", charges = "GoldenFishhookCharges" },
	{ item = "Fishhook",        charges = "FishhookCharges" },
}

function Fn.useFishItem(name)
	if os.clock() - (lastUsed[name] or -math.huge) < 8 then return false end
	lastUsed[name] = os.clock()
	return Fn.fire("ConsumablesService", "UseItem", name, 1)
end

function Fn.useFishBoosts()
	if next(State.boostItems) == nil then
		Fn.setFeature("fishBoost", "pick the worms / hooks to use under 'Worms & Hooks To Use'")
		return
	end

	local wormLive = false
	for _, worm in ipairs(WORM_ORDER) do
		local left = Fn.hudTimeLeft(worm)
		if left and left > 0 then wormLive = true end
	end
	-- Only the worms and hooks the player picked are ever used; a live one of any
	-- kind still counts, so nothing is wasted stacking on top of it.
	if not wormLive then
		for _, worm in ipairs(WORM_ORDER) do
			if State.boostItems[worm] and Fn.ownedCount(worm) > 0 and Fn.useFishItem(worm) then
				Fn.setFeature("fishBoost", "used " .. worm)
				break
			end
		end
	end

	local hookLive = false
	for _, hook in ipairs(HOOKS) do
		local charges = Fn.dataValue("FishingItemsData", hook.charges)
		local left = Fn.hudTimeLeft(hook.item)
		if (type(charges) == "number" and charges > 0) or (left and left > 0) then hookLive = true end
	end
	if not hookLive then
		for _, hook in ipairs(HOOKS) do
			if State.boostItems[hook.item] and Fn.ownedCount(hook.item) > 0 and Fn.useFishItem(hook.item) then
				Fn.setFeature("fishBoost", "used " .. hook.item)
				break
			end
		end
	end
end

useFishBoostsHook = Fn.useFishBoosts

-- Selling ----------------------------------------------------------------------

local SELL_TIERS = { { "", "Normal" }, { "Golden ", "Golden" }, { "Diamond ", "Diamond" } }

-- The chosen fish (by name): every one, or all but one with Keep 1 on; and what they are worth in tokens.
function Fn.sellableFish()
	local cfg = Fn.getModule("Merchant")
	local prices = cfg and cfg.SellPrices
	if type(prices) ~= "table" then return {}, 0 end

	local unsellable = type(cfg.UNSELLABLE) == "table" and cfg.UNSELLABLE or {}
	local mults = type(cfg.TIER_MULTIPLIER) == "table" and cfg.TIER_MULTIPLIER or { Normal = 1, Golden = 6, Diamond = 36 }

	local entries, tokens = {}, 0
	for base, price in pairs(prices) do
		if State.sellNames[base] and not unsellable[base] then
			for _, tier in ipairs(SELL_TIERS) do
				local isNormal = tier[1] == ""
				if isNormal or State.sellVariants then
					local name = tier[1] .. base
					local spare = Fn.petCount(name) - (State.sellKeepOne and 1 or 0)
					if spare > 0 then
						entries[#entries + 1] = { name = name, amount = spare, tier = tier[2] }
						tokens = tokens + spare * price * (mults[tier[2]] or 1)
					end
				end
			end
		end
	end
	table.sort(entries, function(a, b) return a.name < b.name end)
	return entries, tokens
end

-- Entry payloads in the shapes the sell remote might expect.
function Fn.asRecords(list, withTier)
	local out = {}
	for _, e in ipairs(list) do
		out[#out + 1] = withTier and { Name = e.name, Amount = e.amount, Tier = e.tier } or { Name = e.name, Amount = e.amount }
	end
	return out
end

local lastSellAt = -math.huge

-- What the server's own reply says: true (accepted), false (refused), nil (cannot tell).
function Fn.replyVerdict(ok, res)
	if not ok then return false end
	local v = res and res[1]
	if v == true then return true end
	if v == false then return false end
	if type(v) == "table" then
		for _, key in ipairs({ "Ok", "ok", "Success", "success" }) do
			if v[key] ~= nil then return v[key] == true end
		end
		for _, key in ipairs({ "Error", "error", "Reason", "reason", "Err" }) do
			if type(v[key]) == "string" then return false end
		end
	end
	return nil
end

-- One round of trying the sell formats. Success is the server saying so, or the
-- game's own numbers moving (tokens up, or the first pet's count down).
function Fn.attemptSell(entries, interrupted, force)
	local first = entries[1]
	local tokensBefore, firstBefore = Fn.fishTokens(), Fn.petCount(first.name)

	local lastOk, lastRes
	local function call(...)
		lastOk, lastRes = nil, nil
		lastOk, lastRes = Fn.invoke("FishingMerchantService", "SellPets", ...)
	end

	local ok = Fn.tryForms("sellPets", {
		function(list) call(Fn.asRecords(list, false)) end,
		function(list)
			local rows = {}
			for _, e in ipairs(list) do rows[#rows + 1] = { e.name, e.amount } end
			call(rows)
		end,
		function(list)
			local map = {}
			for _, e in ipairs(list) do map[e.name] = e.amount end
			call(map)
		end,
		function(list) call(Fn.asRecords(list, true)) end,
		function(list) call(list[1].name, list[1].amount) end,
	}, function()
		if Fn.replyVerdict(lastOk, lastRes) == true then return true end
		local now = Fn.fishTokens()
		if tokensBefore and now and now > tokensBefore then return true end
		return Fn.petCount(first.name) < firstBefore
	end, entries, 4, interrupted, force)

	return ok, tokensBefore, lastOk, lastRes
end

-- A sale is only finished when the game's numbers show it. Stay until they do,
-- so the trip never heads home with the sale still being processed.
function Fn.confirmSale(entries, before, tokensBefore, interrupted)
	local deadline = os.clock() + 8
	while os.clock() < deadline and not interrupted() do
		local tokens = Fn.fishTokens()
		local tokensUp = tokensBefore ~= nil and tokens ~= nil and tokens > tokensBefore

		local sold = true
		for _, e in ipairs(entries) do
			if Fn.petCount(e.name) > (before[e.name] or 0) - e.amount then
				sold = false
				break
			end
		end

		if tokensUp or sold then break end
		task.wait(0.5)
	end
	task.wait(1) -- a moment for the server to finish before we leave
end

function Fn.sellFish(interrupted)
	local cfg = Fn.getModule("Merchant")
	local entries = Fn.sellableFish()
	if #entries == 0 then Fn.setFeature("fishSell", "nothing to sell") return false end
	lastSellAt = os.clock()

	-- One call carries a limited number of entries.
	local cap = cfg and tonumber(cfg.MAX_SELL_ENTRIES) or 250
	while #entries > cap do table.remove(entries) end

	local before = {}
	for _, e in ipairs(entries) do before[e.name] = Fn.petCount(e.name) end

	Fn.setFeature("fishSell", "selling...")
	local ok, tokensBefore, lastOk, lastRes = Fn.attemptSell(entries, interrupted, false)

	-- A refusal right after arriving is usually just too soon: give the server a
	-- moment and ask once more before giving up.
	if not ok and not interrupted() then
		Fn.setFeature("fishSell", "retrying sale...")
		task.wait(2)
		ok, tokensBefore, lastOk, lastRes = Fn.attemptSell(entries, interrupted, true)
	end

	if ok then
		Fn.setFeature("fishSell", "confirming sale...")
		Fn.confirmSale(entries, before, tokensBefore, interrupted)

		Stats.claims = Stats.claims + 1 -- counts as progress for the merchant's backoff
		local gained = (Fn.fishTokens() or 0) - (tokensBefore or 0)
		Fn.setFeature("fishSell", string.format("sold %d fish type(s), +%d tokens", #entries, math.max(gained, 0)))
	else
		local said = lastOk and Fn.describe(lastRes and lastRes[1]) or tostring(lastRes and lastRes[1] or "no reply")
		Fn.setFeature("fishSell", "sale was not accepted: " .. said)
	end
	return ok
end

-- Time to sell: the interval has passed and some chosen fish are above the amount kept.
function Fn.sellDue()
	if not State.autoSellFish then return false end
	if next(State.sellNames) == nil then
		Fn.setFeature("fishSell", "pick the fish to sell under 'Fish To Sell'")
		return false
	end
	if os.clock() - lastSellAt < State.sellInterval * 60 then return false end
	local entries = Fn.sellableFish()
	return #entries > 0
end

-- Fishing tree -----------------------------------------------------------------

local TREE_PRIORITIES = { "Cheapest First", "Speed", "Luck", "Rubies", "Mastery", "Golden Catch" }
local PRIORITY_KEYWORD = { Speed = "speed", Luck = "luck", Rubies = "rubies", Mastery = "mastery", ["Golden Catch"] = "golden" }

function Fn.treeNodeOwned(id)
	if id == "fish_start" then return true end
	return Fn.dataValue("FishingTreeData", id) == true
end

-- The next node to buy: affordable, parent owned, not already skipped this trip.
-- Nodes in the chosen priority group come first, cheapest first within a group.
function Fn.nextTreeNode(tokens, skip)
	local nodes = Fn.getModule("FishTree")
	if type(nodes) ~= "table" then return nil end

	local keyword = PRIORITY_KEYWORD[State.fishTreePriority]
	local best, bestRank, bestCost
	for _, node in ipairs(nodes) do
		if type(node) == "table" and type(node.id) == "string" and node.id ~= "fish_start"
			and not (skip and skip[node.id]) then
			local cost = tonumber(node.cost)
			if cost and cost <= tokens and not Fn.treeNodeOwned(node.id)
				and (node.parent == nil or Fn.treeNodeOwned(node.parent)) then
				local label = string.lower(tostring(node.group or node.id))
				local rank = (keyword and label:find(keyword, 1, true)) and 0 or 1
				if not best or rank < bestRank or (rank == bestRank and cost < bestCost) then
					best, bestRank, bestCost = node, rank, cost
				end
			end
		end
	end
	return best
end

-- Spends every token it can in one trip, in priority order. Buying a node can
-- unlock its children, so the list is re-read after each purchase. A node the
-- server refuses is set aside for the rest of the trip instead of ending it.
function Fn.buyFishTree(interrupted)
	local tokens = Fn.fishTokens()
	if not tokens then Fn.setFeature("fishTree", "token balance unavailable") return 0 end

	local bought, spent = 0, 0
	local skip = {}
	local budget = tokens -- tracked locally: the game's balance can lag behind a purchase

	for _ = 1, 100 do -- a safety stop; the loop normally ends when nothing is affordable
		if not Fn.alive() or interrupted() then break end

		-- Never plan with more than the game says we have (tokens may have been spent elsewhere).
		budget = math.min(budget, Fn.fishTokens() or budget)

		local node = Fn.nextTreeNode(budget, skip)
		if not node then break end

		local ok = Fn.tryForms("fishTree", {
			function(id) Fn.invoke("FishingMerchantService", "BuyTreeNode", id) end,
			function(id) Fn.invoke("FishingMerchantService", "BuyTreeNode", { id }) end,
			function(id) Fn.invoke("FishingMerchantService", "BuyTreeNode", id, 1) end,
		}, function() return Fn.treeNodeOwned(node.id) end, node.id, 2.5, interrupted, true)

		if ok then
			bought = bought + 1
			spent = spent + node.cost
			budget = budget - node.cost
			Stats.upgrades = Stats.upgrades + 1
			Fn.setFeature("fishTree", string.format("bought %s (%d so far)", tostring(node.title or node.id), bought))
		else
			skip[node.id] = true -- refused: try the next one instead of stopping

			-- If no purchase format has ever been accepted, every node will fail the
			-- same way; two refusals is enough to know, and saves minutes of probing.
			local refused = 0
			for _ in pairs(skip) do refused = refused + 1 end
			if ProbeCache["fishTree"] == nil and refused >= 2 then break end
		end
	end

	if bought > 0 then
		Fn.setFeature("fishTree", string.format("bought %d upgrade(s) for %d tokens", bought, spent))
	elseif next(skip) ~= nil then
		Fn.setFeature("fishTree", "the server refused every affordable upgrade")
	else
		Fn.setFeature("fishTree", "nothing affordable right now")
	end
	return bought
end

-- Merchant offers ----------------------------------------------------------------

-- Offers are rolled every 30 minutes and published as JSON on the Fishing
-- folder: {"O":[[slot,id,stock],...],"R":restockId}.
function Fn.merchantOffers()
	local folder = ReplicatedStorage:FindFirstChild("Fishing")
	local raw = folder and folder:GetAttribute("FishingMerchantStock")
	if type(raw) ~= "string" then return {}, nil end

	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not (ok and type(data) == "table") then return {}, nil end

	local offers = {}
	for _, o in ipairs(data.O or {}) do
		offers[#offers + 1] = { slot = o[1], id = o[2], stock = tonumber(o[3]) or 1 }
	end
	return offers, data.R
end

function Fn.poolEntry(id)
	local cfg = Fn.getModule("Merchant")
	for _, entry in ipairs(cfg and cfg.Pool or {}) do
		if entry.Id == id then return entry end
	end
	return nil
end

-- The fishing boosters, unless the player picked something else.
local DEFAULT_WANTS = {}
for _, id in ipairs({ "Worm", "Worm1", "Worm2", "UniverseWorm", "Fishhook", "GoldenFishhook",
	"FishingCharm1", "FishingCharm2", "FishingCharm3", "CannedTuna" }) do
	DEFAULT_WANTS[id] = true
end

function Fn.wantedOffers()
	return next(State.merchantWants) and State.merchantWants or DEFAULT_WANTS
end

local merchantDone = {} -- "<restock>_<slot>" once an offer has been dealt with

-- Offers worth buying right now: wanted, in stock, affordable, not already handled.
function Fn.buyableOffers(tokens)
	local offers, restock = Fn.merchantOffers()
	local wants = Fn.wantedOffers()
	local list = {}
	for _, offer in ipairs(offers) do
		local entry = Fn.poolEntry(offer.id)
		local key = tostring(restock) .. "_" .. tostring(offer.slot)
		if wants[offer.id] and entry and offer.stock > 0 and not merchantDone[key]
			and tonumber(entry.Price) and tonumber(entry.Price) <= tokens then
			list[#list + 1] = { offer = offer, price = tonumber(entry.Price), key = key }
		end
	end
	table.sort(list, function(a, b) return a.price < b.price end)
	return list
end

function Fn.buyMerchantOffers(interrupted)
	local bought = 0
	local tokens = Fn.fishTokens()
	if not tokens then Fn.setFeature("fishBuy", "token balance unavailable") return 0 end

	for _, item in ipairs(Fn.buyableOffers(tokens)) do
		if interrupted() then break end
		merchantDone[item.key] = true -- one pass per offer per restock, whatever happens

		for _ = 1, item.offer.stock do
			local now = Fn.fishTokens() or 0
			if now < item.price or interrupted() then break end

			local ok = Fn.tryForms("merchantBuy", {
				function(o) Fn.invoke("FishingMerchantService", "Buy", o.slot) end,
				function(o) Fn.invoke("FishingMerchantService", "Buy", o.slot, 1) end,
				function(o) Fn.invoke("FishingMerchantService", "Buy", o.id) end,
				function(o) Fn.invoke("FishingMerchantService", "Buy", o.id, 1) end,
				function(o)
					local cfg = Fn.getModule("Merchant")
					local slotId = cfg and cfg.SlotId and cfg.SlotId(o.slot)
					if slotId then Fn.invoke("FishingMerchantService", "Buy", slotId) end
				end,
			}, function()
				local after = Fn.fishTokens()
				return after ~= nil and after < now
			end, item.offer, 2.5, interrupted)

			if not ok then break end
			bought = bought + 1
			Stats.claims = Stats.claims + 1
			Fn.setFeature("fishBuy", "bought " .. item.offer.id)
		end
	end
	if bought == 0 then Fn.setFeature("fishBuy", "nothing wanted is in stock or affordable") end
	return bought
end

-- Merchant trip ------------------------------------------------------------------

local MERCHANT_TRIP_LIMIT = 300 -- the walk can be long; the actions come after it

function Fn.merchantWork(manual)
	return function(interrupted)
		local function trip(text) Fn.setFeature("fishTrip", text) end
		local function stopped(where)
			if not interrupted() then return false end
			trip("cut short " .. where .. " (" .. ErrandInfo.stop .. ")")
			return true
		end

		-- Start from a clean slate so a line from an earlier trip is never mistaken
		-- for this one.
		FeatureStatus.fishSell, FeatureStatus.fishTree, FeatureStatus.fishBuy = nil, nil, nil

		trip("travelling")
		if Fn.currentWorld() ~= MERCHANT_WORLD and not Fn.travelToWorld(MERCHANT_WORLD, nil, interrupted) then
			trip("could not reach " .. tostring(MERCHANT_WORLD))
			return
		end
		if stopped("on arrival") then return end

		-- The world may still be streaming in when we land.
		local part
		for _ = 1, 16 do
			local map = Workspace:FindFirstChild("Map")
			local machines = map and map:FindFirstChild("Machines")
			local machine = machines and machines:FindFirstChild("MerchantFishing")
			part = machine and (machine.PrimaryPart or machine:FindFirstChildWhichIsA("BasePart", true))
			if part or interrupted() then break end
			task.wait(0.5)
		end
		if not part then
			trip("merchant stall not found")
			return
		end

		-- Everything below needs us beside the merchant; the server refuses it from
		-- anywhere else. Try again a couple of times before giving up on the walk.
		local spot = Fn.groundAt(part.Position)
		local near = false
		for _ = 1, 3 do
			Fn.teleportTo(spot, 12, 40, interrupted)
			local hrp = Fn.getHRP()
			near = hrp ~= nil and Fn.flatDistance(hrp.Position, part.Position) <= 20
			if near or interrupted() then break end
		end
		if stopped("on the way") then return end
		if not near then trip("could not get beside the merchant (" .. tostring(FeatureStatus.move) .. ")") end

		-- The server needs a moment to register that we are standing at the
		-- merchant; asking before that gets the request refused.
		task.wait(1.5)
		if stopped("at the merchant") then return end

		-- Sell first: that is where most tokens come from. Then spend them,
		-- upgrades before one-off offers. Each step finishes (and is confirmed)
		-- before the next begins, and before the trip heads home.
		local did = {}
		if manual or Fn.sellDue() then
			trip("selling")
			Fn.sellFish(interrupted)
			did[#did + 1] = "sell"
		else
			Fn.setFeature("fishSell", "skipped (not due)")
		end
		if stopped("after selling") then return end
		task.wait(0.5)
		if manual or State.autoFishTree then
			trip("buying upgrades")
			Fn.buyFishTree(interrupted)
			did[#did + 1] = "upgrades"
		else
			Fn.setFeature("fishTree", "skipped (off)")
		end
		if stopped("after upgrades") then return end
		task.wait(0.5)
		if manual or State.autoMerchantBuy then
			trip("buying offers")
			Fn.buyMerchantOffers(interrupted)
			did[#did + 1] = "offers"
		else
			Fn.setFeature("fishBuy", "skipped (off)")
		end

		trip(#did > 0 and ("done: " .. table.concat(did, ", ")) or "nothing was due")
	end
end

local merchantBackoffUntil = 0

function Fn.merchantTrip(manual)
	local before = Stats.claims + Stats.upgrades
	Fn.errandTrip("FishMerchant", Fn.merchantWork(manual == true),
		function()
			return manual == true or State.autoSellFish or State.autoMerchantBuy or State.autoFishTree
		end, MERCHANT_TRIP_LIMIT)

	-- A trip that achieved nothing (a call format the server refuses, no stock)
	-- would just repeat every minute, so the automatic loop rests for a while.
	if manual ~= true and Stats.claims + Stats.upgrades == before then
		merchantBackoffUntil = os.clock() + 300
	end
end

-- Worth a trip? Only when something concrete can happen, so the character is
-- not pulled off the water for nothing.
function Fn.merchantDue()
	if os.clock() < merchantBackoffUntil then return false end

	if Fn.sellDue() then return true end

	local balance = Fn.fishTokens() or 0
	if State.autoFishTree and Fn.nextTreeNode(balance) then return true end
	if State.autoMerchantBuy and #Fn.buyableOffers(balance) > 0 then return true end
	return false
end

Fn.runLoop("FishMerchant",
	function() return State.autoSellFish or State.autoMerchantBuy or State.autoFishTree end,
	function()
		if Fn.merchantDue() then Fn.merchantTrip(false) end
	end, function() return 60 end, 0.1)

-----------------------------------------------------------
-- WEBHOOK (NisulRocks Script Hub)
-----------------------------------------------------------

-- Every message is branded as the NisulRocks Script Hub (its red, its title
-- style, the Discord invite) and goes through one queue, so a burst of events
-- can never trip Discord's rate limit. What gets sent is chosen per data type
-- on the Webhook tab: big hatches, a periodic session summary, and events.

local HUB = {
	Name    = "NisulRocks Script Hub",
	Game    = "Pets Universe",
	Version = "V1.0.3",
	Invite  = "https://discord.gg/jUctfTAa5D",
	Red     = 0xFF1E1E, -- the hub's neon red
	Green   = 0x00FF78,
	Blue    = 0x6464FF,
	Gold    = 0xFFD700,
}

local RARITY_RANK   = { Basic = 1, Rare = 2, Epic = 3, Legendary = 4, Mythical = 5, Secret = 6 }
local RARITY_COLORS = { Basic = 9807270, Rare = 3447003, Epic = 10181046, Legendary = 15844367, Mythical = 15105570, Secret = 16766720 }
local RARITY_LIST   = { "Basic", "Rare", "Epic", "Legendary", "Mythical", "Secret" }

local httpRequest = request or http_request or (syn and syn.request) or (http and http.request)

function Fn.validWebhookUrl(url)
	if type(url) ~= "string" then return false end
	-- Only ever post to real Discord webhook endpoints.
	return url:match("^https://discord%.com/api/webhooks/") ~= nil
		or url:match("^https://discordapp%.com/api/webhooks/") ~= nil
end

-- Formatting -------------------------------------------------------------------

local ABBREV_STEPS = { { 1e15, "qa" }, { 1e12, "t" }, { 1e9, "b" }, { 1e6, "m" }, { 1e3, "k" } }

-- 12345 -> "12.35k". Negative numbers keep their sign.
function Fn.abbrev(n)
	if type(n) ~= "number" then return "?" end
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	for _, step in ipairs(ABBREV_STEPS) do
		if n >= step[1] then
			local text = string.format("%.2f", n / step[1]):gsub("%.?0+$", "")
			return sign .. text .. step[2]
		end
	end
	return sign .. tostring(math.floor(n + 0.5))
end

function Fn.signed(n)
	return (n >= 0 and "+" or "") .. Fn.abbrev(n)
end

function Fn.durationText(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h, m = math.floor(seconds / 3600), math.floor((seconds % 3600) / 60)
	if h > 0 then return string.format("%dh %02dm", h, m) end
	return string.format("%dm", m)
end

-- Sending ----------------------------------------------------------------------

local WebhookQueue = { items = {}, sent = 0, failed = 0, lastSentAt = nil, lastError = "" }

function Fn.clip(text, limit)
	text = tostring(text)
	return #text > limit and (text:sub(1, limit - 1) .. "…") or text
end

function Fn.buildEmbed(spec)
	local hide = State.webhookHideName
	local who = hide and "Anonymous" or LocalPlayer.Name

	local fields
	if spec.fields then
		fields = {}
		for i, f in ipairs(spec.fields) do
			if i > 25 then break end
			fields[i] = { name = Fn.clip(f.name, 256), value = Fn.clip(f.value, 1024), inline = f.inline == true }
		end
	end

	local embed = {
		author = { name = HUB.Name .. "  //  " .. HUB.Game, url = HUB.Invite },
		title = spec.title and Fn.clip(spec.title, 256) or nil,
		description = spec.description and Fn.clip(spec.description, 4000) or nil,
		color = spec.color or HUB.Red,
		fields = fields,
		footer = { text = string.format("%s  •  %s  •  discord.gg/jUctfTAa5D", who, HUB.Version) },
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
	}
	if not hide then
		embed.thumbnail = { url = string.format(
			"https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", LocalPlayer.UserId) }
	end
	return embed
end

-- Queues a message: { title, description, color, fields = { { name, value, inline } } }.
-- Returns false when no valid webhook URL is set or the executor cannot make requests.
function Webhook.post(spec)
	if not httpRequest or not Fn.validWebhookUrl(State.webhookUrl) then return false end
	if #WebhookQueue.items >= 20 then table.remove(WebhookQueue.items, 1) end
	WebhookQueue.items[#WebhookQueue.items + 1] = spec
	return true
end

task.spawn(function()
	local nextAt = 0
	while Fn.alive() do
		local spec = WebhookQueue.items[1]
		if spec and os.clock() >= nextAt and Fn.validWebhookUrl(State.webhookUrl) and httpRequest then
			table.remove(WebhookQueue.items, 1)

			local ok, res = pcall(function()
				return httpRequest({
					Url = State.webhookUrl,
					Method = "POST",
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode({ username = HUB.Name, embeds = { Fn.buildEmbed(spec) } }),
				})
			end)

			local status = ok and type(res) == "table" and (res.StatusCode or res.status_code) or nil
			if ok and (status == nil or (status >= 200 and status < 300)) then
				WebhookQueue.sent = WebhookQueue.sent + 1
				WebhookQueue.lastSentAt = os.time()
				nextAt = os.clock() + 1.5
			elseif status == 429 then
				table.insert(WebhookQueue.items, 1, spec) -- Discord asked us to slow down; retry
				WebhookQueue.lastError = "rate limited (retrying)"
				nextAt = os.clock() + 6
			else
				WebhookQueue.failed = WebhookQueue.failed + 1
				WebhookQueue.lastError = ok and ("HTTP " .. tostring(status)) or tostring(res)
				nextAt = os.clock() + 1.5
			end
		end
		task.wait(0.3)
	end
end)

-- A quick branded post for event-style alerts.
function Webhook.alert(title, body, color)
	Fn.notify(title, body, 6)
	Webhook.post({ title = title, description = body, color = color or HUB.Blue })
end

-- Hatch tracking ---------------------------------------------------------------

-- Fed by the game's own hatch-result event, so it knows the exact pet, rarity and
-- egg of every hatch (and, unlike comparing pet counts, is not fooled by crafting).
local HatchLog = { total = 0, byRarity = {}, seen = {} }

function Fn.baseName(petName)
	return (tostring(petName):gsub("|.*$", ""):gsub("^Golden ", ""):gsub("^Diamond ", ""))
end

-- Drop chance in percent from the egg's own pool, or nil when it is not listed.
function Fn.petChance(petName, eggName)
	local handler = Fn.getModule("EggHandler")
	local pool = type(handler) == "table" and handler[eggName]
	if type(pool) ~= "table" then return nil end
	local base = Fn.baseName(petName)
	for _, entry in ipairs(pool) do
		if type(entry) == "table" and entry.Name == base then return tonumber(entry.Chance) end
	end
	return nil
end

function Fn.petRarity(petName)
	local handler = Fn.getModule("EggHandler")
	if type(handler) ~= "table" then return "Basic" end
	local base = Fn.baseName(petName)
	for _, pool in pairs(handler) do
		if type(pool) == "table" then
			for _, pet in ipairs(pool) do
				if type(pet) == "table" and pet.Name == base then return pet.Rarity or "Basic" end
			end
		end
	end
	return "Basic"
end

function Fn.oddsText(chance)
	if not chance or chance <= 0 then return "unknown" end
	return "1 in " .. Fn.abbrev(100 / chance)
end

function Fn.onHatchResult(pets, _, eggName)
	if type(pets) ~= "table" then return end

	local minRank = RARITY_RANK[State.minRarity] or 4
	local tally, order = {}, {}

	for _, pet in ipairs(pets) do
		if type(pet) == "table" and type(pet.Name) == "string" then
			local rarity = pet.Rarity or Fn.petRarity(pet.Name)
			local rank = RARITY_RANK[rarity] or 1

			HatchLog.total = HatchLog.total + 1
			HatchLog.byRarity[rarity] = (HatchLog.byRarity[rarity] or 0) + 1

			local key = rarity .. "|" .. pet.Name .. "|" .. tostring(eggName)
			local rec = HatchLog.seen[key]
			if not rec then
				rec = { name = pet.Name, rarity = rarity, rank = rank, egg = eggName, count = 0,
					chance = Fn.petChance(pet.Name, eggName) }
				HatchLog.seen[key] = rec
			end
			rec.count = rec.count + 1

			if rank >= minRank then
				if not tally[key] then
					tally[key] = { rec = rec, n = 0 }
					order[#order + 1] = key
				end
				tally[key].n = tally[key].n + 1
			end
		end
	end

	if not State.hatchWebhook or #order == 0 then return end

	-- One message per hatch, however many big pets it held; the rarest leads.
	table.sort(order, function(a, b)
		local ra, rb = tally[a].rec, tally[b].rec
		if ra.rank ~= rb.rank then return ra.rank > rb.rank end
		return (ra.chance or 100) < (rb.chance or 100)
	end)

	local lines, top = {}, tally[order[1]].rec
	for i = 1, math.min(#order, 10) do
		local rec, n = tally[order[i]].rec, tally[order[i]].n
		lines[#lines + 1] = string.format("• **%s** %s  x%d  (%s)", rec.rarity, rec.name, n, Fn.oddsText(rec.chance))
	end

	Webhook.post({
		title = #order == 1 and string.format("Hatched a %s: %s", top.rarity, top.name)
			or string.format("Big hatch! %d notable pets", #order),
		description = table.concat(lines, "\n"),
		color = RARITY_COLORS[top.rarity] or HUB.Gold,
		fields = {
			{ name = "Egg", value = tostring(eggName), inline = true },
			{ name = "Eggs hatched this session", value = tostring(HatchLog.total), inline = true },
		},
	})
end

-- The game's own animation listeners are switched off by "Disable Hatch
-- Animation". Ours must survive that, so it is only attached once a hatch data
-- type is enabled, and the animation sweep is told which listener is ours.
local hatchListenerAttached = false

function Fn.ensureHatchListener()
	if hatchListenerAttached then return end
	local remote = Fn.resultRemote()
	if not remote then return end

	hatchResultHandler = Fn.onHatchResult -- before connecting, so the very first sweep spares it
	remote.OnClientEvent:Connect(hatchResultHandler)
	hatchListenerAttached = true

	-- Can the executor tell our listener apart from the game's? If not, the
	-- animation sweep must not disable listeners, or it would silence this too.
	if typeof(getconnections) == "function" then
		hatchListenerVisible = false
		local ok, conns = pcall(getconnections, remote.OnClientEvent)
		if ok and type(conns) == "table" then
			for _, conn in ipairs(conns) do
				if Fn.isOwnHatchListener(conn) then hatchListenerVisible = true end
			end
		end
		if hatchListenerVisible == false and State.noHatchAnim then
			Fn.notify("Hatch Webhook", "This executor cannot tell listeners apart, so Disable Hatch Animation is limited while hatch data is sent", 8)
		end
	end
end

-- Session summary --------------------------------------------------------------

local Session = { startClock = os.clock(), base = {}, lastSummaryAt = os.clock() }

function Fn.readStats()
	return { Coins = Fn.currencyOf("Coins"), Rubies = Fn.currencyOf("Rubies"), Eggs = Fn.currencyOf("Eggs"), Tokens = Fn.fishTokens() }
end

-- The stats may not be loaded when the script starts, so each baseline is the
-- first real reading we see.
task.spawn(function()
	while Fn.alive() do
		for key, value in pairs(Fn.readStats()) do
			if Session.base[key] == nil and value ~= nil then Session.base[key] = value end
		end
		task.wait(5)
	end
end)

local SUMMARY_PARTS = { "Income Per Hour", "Hatch Highlights", "Fishing", "Activity", "Uptime" }

-- Nothing selected means everything.
function Fn.partOn(name)
	return next(State.summaryParts) == nil or State.summaryParts[name] == true
end

function Fn.sendSummary()
	local elapsed = os.clock() - Session.startClock
	local hours = math.max(elapsed / 3600, 1 / 60)
	local now = Fn.readStats()
	local fields = {}

	if Fn.partOn("Income Per Hour") then
		local lines = {}
		for _, key in ipairs({ "Coins", "Rubies", "Eggs" }) do
			local a, b = Session.base[key], now[key]
			if a and b then
				lines[#lines + 1] = string.format("**%s**  %s  (%s/h)", key, Fn.signed(b - a), Fn.abbrev((b - a) / hours))
			end
		end
		fields[#fields + 1] = { name = "Income", value = #lines > 0 and table.concat(lines, "\n") or "stats not loaded yet" }
	end

	if Fn.partOn("Hatch Highlights") then
		local counts = {}
		for i = #RARITY_LIST, 1, -1 do
			local n = HatchLog.byRarity[RARITY_LIST[i]]
			if n and n > 0 then counts[#counts + 1] = string.format("%s %d", RARITY_LIST[i], n) end
		end

		local records = {}
		for _, rec in pairs(HatchLog.seen) do records[#records + 1] = rec end
		table.sort(records, function(a, b)
			if a.rank ~= b.rank then return a.rank > b.rank end
			if (a.chance or 100) ~= (b.chance or 100) then return (a.chance or 100) < (b.chance or 100) end
			return a.count > b.count
		end)

		local best = {}
		for i = 1, math.min(#records, 5) do
			local r = records[i]
			best[#best + 1] = string.format("• **%s** %s  x%d  (%s, %s)", r.rarity, r.name, r.count, tostring(r.egg), Fn.oddsText(r.chance))
		end

		fields[#fields + 1] = {
			name = string.format("Hatches (%d)", HatchLog.total),
			value = (#counts > 0 and table.concat(counts, "  |  ") or "none yet")
				.. (#best > 0 and ("\n\n**Best hatches**\n" .. table.concat(best, "\n")) or ""),
		}
	end

	if Fn.partOn("Fishing") then
		local tokens = ""
		if Session.base.Tokens and now.Tokens then
			local d = now.Tokens - Session.base.Tokens
			tokens = string.format("\nTokens %s  (%s/h)", Fn.signed(d), Fn.abbrev(d / hours))
		end
		fields[#fields + 1] = {
			name = "Fishing",
			value = string.format("Caught %d  |  Last: %s%s", Stats.fish, tostring(Fish.lastCatch), tokens),
			inline = true,
		}
	end

	if Fn.partOn("Activity") then
		fields[#fields + 1] = {
			name = "Activity",
			value = string.format("Clicks %s  |  Hatch calls %s  |  Claims %d\nCrafts %d  |  Upgrades %d  |  Errors %d",
				Fn.abbrev(Stats.clicks), Fn.abbrev(Stats.hatches), Stats.claims, Stats.crafts, Stats.upgrades, Stats.errors),
			inline = true,
		}
	end

	if Fn.partOn("Uptime") then
		fields[#fields + 1] = { name = "Uptime", value = Fn.durationText(elapsed), inline = true }
	end

	local posted = Webhook.post({
		title = "Session Summary",
		description = "How this session is going so far.",
		color = HUB.Red,
		fields = fields,
	})
	Fn.setFeature("webhook", posted and "summary queued" or "summary not sent - set a valid webhook URL")
	return posted
end

Fn.runLoop("WebhookSummary", function() return State.webhookSummary end, function()
	if os.clock() - Session.lastSummaryAt >= State.summaryInterval * 60 then
		Session.lastSummaryAt = os.clock()
		Fn.sendSummary()
	end
end, function() return 20 end, 0)

-- Test -------------------------------------------------------------------------

function Fn.sendWebhookTest()
	local on = {}
	if State.hatchWebhook then on[#on + 1] = "Big hatches (" .. State.minRarity .. " and above)" end
	if State.webhookSummary then on[#on + 1] = string.format("Session summary every %d min", State.summaryInterval) end
	if State.eventAlerts then on[#on + 1] = "Events & alien egg alerts" end

	local posted = Webhook.post({
		title = "Webhook connected",
		description = "Messages from the script will arrive here.",
		color = HUB.Green,
		fields = { {
			name = "Sending",
			value = #on > 0 and table.concat(on, "\n") or "Nothing enabled yet - turn on the data you want in the Webhook tab.",
		} },
	})
	if not posted then
		Fn.notify("Webhook", httpRequest and "Paste a valid Discord webhook URL first" or "This executor cannot make HTTP requests", 6)
	end
	return posted
end

