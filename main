	return ScriptTab:CreateButton({
		Name = "Unload Script",
		Callback = function()
			State.unloaded = true
			Fn.setAutoFish(false)
			Fn.restoreHatchAnimation()
			Fn.ensureBuiltInAuto(false, true)
			pcall(function() RunService:Set3dRenderingEnabled(true) end)
			Fn.setLowGfx(false)
			env.NisulPURayfield = nil
			pcall(function() Rayfield:Destroy() end)
		end,
	})
end)

-----------------------------------------------------------
-- DASHBOARD REFRESH
-----------------------------------------------------------

function Fn.formatDuration(seconds)
	return string.format("%02d:%02d:%02d",
		math.floor(seconds / 3600), math.floor((seconds % 3600) / 60), seconds % 60)
end

function Fn.refreshStats()
	if not StatsParagraph then return end
	StatsParagraph:Set({
		Title = "Statistics",
		Content = string.format(
			"Runtime: %s\nClicks: %d | Hatches: %d | Claims: %d\nCrafts: %d | Upgrades: %d | Errors: %d\nCoins: %s | Rubies: %s | Eggs: %s",
			Fn.formatDuration(os.time() - Stats.startTime),
			Stats.clicks, Stats.hatches, Stats.claims, Stats.crafts, Stats.upgrades, Stats.errors,
			tostring(LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Coins") and LocalPlayer.leaderstats.Coins.Value or "?"),
			tostring(LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Rubies") and LocalPlayer.leaderstats.Rubies.Value or "?"),
			tostring(LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Eggs") and LocalPlayer.leaderstats.Eggs.Value or "?")),
	})
end

-- Index status moves faster than the dashboard (it changes every hatch), so it
-- has its own light refresh and only redraws when the text changes.
local lastIndexText = nil

task.spawn(function()
	while Fn.alive() do
		local ok, err = pcall(Fn.refreshStats)
		if not ok then warn("[PU] dashboard refresh: " .. tostring(err)) end

		pcall(function()
			if IndexParagraph and IndexStatus ~= lastIndexText then
				lastIndexText = IndexStatus
				IndexParagraph:Set({ Title = "Index Farming", Content = IndexStatus })
			end
		end)

		-- One line per feature, in a fixed order, only for features that have reported.
		local function statusBlock(order)
			local lines = {}
			for _, entry in ipairs(order) do
				local text = FeatureStatus[entry[1]]
				if text then lines[#lines + 1] = entry[2] .. ": " .. text end
			end
			return #lines > 0 and table.concat(lines, "\n") or "Nothing run yet"
		end

		pcall(function()
			if RewardsParagraph then
				RewardsParagraph:Set({ Title = "Rewards Status", Content = statusBlock({
					{ "indexRewards", "Index" }, { "daily", "Daily" }, { "groupChest", "Group chest" },
					{ "groupRewards", "Group rewards" }, { "vipChest", "VIP chest" }, { "codes", "Codes" },
				}) })
			end
			if TasksParagraph then
				TasksParagraph:Set({ Title = "World Tasks Status", Content = statusBlock({
					{ "special", "Special upgrades" }, { "fruit", "Fruit machine" }, { "ben", "Ben hunt" }, { "move", "Movement" },
				}) })
			end
			if WebhookParagraph then
				local urlState = Fn.validWebhookUrl(State.webhookUrl) and "ready" or (State.webhookUrl == "" and "no URL set" or "not a Discord webhook URL")
				local lines = {
					string.format("URL: %s%s", urlState, httpRequest and "" or " | executor cannot send HTTP"),
					string.format("Sent: %d | Failed: %d | Queued: %d", WebhookQueue.sent, WebhookQueue.failed, #WebhookQueue.items),
					WebhookQueue.lastSentAt and ("Last sent: " .. Fn.durationText(os.time() - WebhookQueue.lastSentAt) .. " ago") or "Nothing sent yet",
				}
				if WebhookQueue.lastError ~= "" then lines[#lines + 1] = "Last error: " .. WebhookQueue.lastError end
				if FeatureStatus.webhook then lines[#lines + 1] = FeatureStatus.webhook end
				WebhookParagraph:Set({ Title = "Webhook Status", Content = table.concat(lines, "\n") })
			end
			if FishingParagraph then
				local lines = {
					FeatureStatus.fishing or "Off",
					string.format("Caught this session: %d | Tokens: %s", Stats.fish, tostring(Fn.fishTokens() or "?")),
				}
				for _, entry in ipairs({ { "fishBoost", "Boosts" }, { "fishTrip", "Merchant trip" }, { "fishSell", "Selling" }, { "fishBuy", "Offers" }, { "fishTree", "Upgrades" } }) do
					if FeatureStatus[entry[1]] then lines[#lines + 1] = entry[2] .. ": " .. FeatureStatus[entry[1]] end
				end
				FishingParagraph:Set({ Title = "Fishing Status", Content = table.concat(lines, "\n") })
			end
			if EventParagraph then
				local names = {}
				for name in pairs(ActiveEvents) do names[#names + 1] = name end
				table.sort(names)
				EventParagraph:Set({ Title = "Events", Content = string.format("Running now: %s\nHatching gate: %s",
					#names > 0 and table.concat(names, ", ") or "none",
					Fn.eventGateOpen() and "open" or "closed (waiting for an event)") })
			end
		end)
		task.wait(2)
	end
end)

task.spawn(function()
	task.wait(3)
	if not DiagnosticsParagraph then return end
	pcall(function()
		local function yesno(v) return v and "ok" or "MISSING" end
		DiagnosticsParagraph:Set({
			Title = "Environment",
			Content = string.format(
				"fireclickdetector: %s | getconnections: %s\nSafeGetService: %s | PlayerData: %s\nPetDisplay: %s | ItemCraftConfig: %s\nBreakablesConfig: %s | WorldsData: %s\nHTTP request (webhook): %s\nUI errors: %s",
				yesno(typeof(fireclickdetector) == "function"),
				yesno(typeof(getconnections) == "function"),
				yesno(Fn.getModule("SafeGet")), yesno(Fn.getModule("PlayerData")),
				yesno(Fn.getModule("PetDisplay")), yesno(Fn.getModule("ItemCraft")),
				yesno(Fn.getModule("BreakablesCfg")), yesno(Fn.dataFolder("WorldsData")),
				yesno(httpRequest),
				#UIErrors > 0 and ("\n  " .. table.concat(UIErrors, "\n  ")) or "none"),
		})
	end)
end)

-----------------------------------------------------------
-- BOOT
-----------------------------------------------------------

-- Applies saved toggle/slider values; callbacks then drive State.
pcall(function() Rayfield:LoadConfiguration() end)

-- A stale copy that lost the generation race tears its own window down.
if not Fn.alive() then
	pcall(function() Rayfield:Destroy() end)
	return
end

Fn.setStatus("Ready")

print("Nisulrocks Scripts Pets Universe AutoFarm V1.0.3 loaded successfully!")
if #UIErrors > 0 then
	warn("[PU] " .. #UIErrors .. " UI element(s) failed - see Script tab Diagnostics")
end

Fn.notify("System Ready", "Welcome to NisulRocks PU AutoFarm V1.0.3", 5)

end, function(err)
	return debug.traceback(tostring(err), 2)
end)

if not bootOk then
	warn("[PU] failed to start: " .. tostring(bootErr))
end

end)
